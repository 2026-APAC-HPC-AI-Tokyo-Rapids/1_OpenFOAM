+#ifndef smoothSolverGaussSeidel_H
+#define smoothSolverGaussSeidel_H
+
+// Internal kernel; included after the OpenFOAM scalar/label declarations.
+namespace Foam
+{
+namespace smoothSolverDetail
+{
+
+// One GaussSeidel sweep of N components that share the off-diagonal
+// coefficients and the addressing. The solution update retains the operations
+// of GaussSeidelSmoother::smooth. On the final sweep, optionally form the
+// residual from upper-neighbour corrections, without a separate L/D/b pass.
+// This is an F3 rounding change: row-formation roundoff is reassociated.
+template<int N, bool Residual = false>
+void gaussSeidelSweep
+(
+    const Foam::label nCells,
+    const Foam::label* const __restrict__ ownStartPtr,
+    const Foam::label* const __restrict__ uPtr,
+    const Foam::scalar* const __restrict__ upperPtr,
+    const Foam::scalar* const __restrict__ lowerPtr,
+    const Foam::scalar* const diagPtr[N],
+    Foam::solveScalar* const psiPtr[N],
+    const Foam::solveScalar* const sourcePtr[N],
+    Foam::solveScalar* const accPtr[N],
+    const Foam::label* const loStartPtr = nullptr,
+    const Foam::label* const losortPtr = nullptr,
+    const Foam::label* const lPtr = nullptr,
+    Foam::solveScalar* const residualPtr[N] = nullptr
+)
+{
+    using namespace Foam;
+
+    solveScalar psii[N];
+    solveScalar delta[N];
+    label fStart;
+    label fEnd = ownStartPtr[0];
+
+    for (label celli=0; celli<nCells; celli++)
+    {
+        // Start and end of this row
+        fStart = fEnd;
+        fEnd = ownStartPtr[celli + 1];
+
+        // Consume and reset after all interface and lower-neighbour terms.
+        for (int k=0; k<N; k++)
+        {
+            psii[k] = sourcePtr[k][celli] + accPtr[k][celli];
+            accPtr[k][celli] = 0;
+        }
+
+        // Accumulate the owner product side
+        for (label facei=fStart; facei<fEnd; facei++)
+        {
+            const scalar a = upperPtr[facei];
+            const label j = uPtr[facei];
+            for (int k=0; k<N; k++)
+            {
+                psii[k] -= a*psiPtr[k][j];
+            }
+        }
+
+        // Finish psi for this cell
+        for (int k=0; k<N; k++)
+        {
+            const solveScalar numerator = psii[k];
+            psii[k] /= diagPtr[k][celli];
+            if constexpr (Residual)
+            {
+                delta[k] = psii[k] - psiPtr[k][celli];
+                // Keep the local division defect as well as -U*delta.
+                // The caller adds B(psi_new)-B(psi_old) afterwards.
+                residualPtr[k][celli] =
+                    numerator - diagPtr[k][celli]*psii[k];
+            }
+        }
+
+        // Distribute the neighbour side using psi for this cell
+        for (label facei=fStart; facei<fEnd; facei++)
+        {
+            const scalar a = lowerPtr[facei];
+            const label j = uPtr[facei];
+            for (int k=0; k<N; k++)
+            {
+                accPtr[k][j] -= a*psii[k];
+            }
+        }
+
+        if constexpr (Residual)
+        {
+            // Incoming faces have owners < celli. Their residuals are
+            // already initialised and will never be reset by this sweep.
+            for (label i=loStartPtr[celli]; i<loStartPtr[celli+1]; ++i)
+            {
+                const label facei = losortPtr[i];
+                const label owner = lPtr[facei];
+                const scalar a = upperPtr[facei];
+                for (int k=0; k<N; k++)
+                {
+                    residualPtr[k][owner] -= a*delta[k];
+                }
+            }
+        }
+
+        for (int k=0; k<N; k++)
+        {
+            psiPtr[k][celli] = psii[k];
+        }
+    }
+}
+
+
+} // End namespace smoothSolverDetail
+} // End namespace Foam
+
+#endif
