-    //solveScalarField bPrime(nCells);
-    solveScalarField& bPrime = matrix_.work(nCells);
-
-    solveScalar* __restrict__ bPrimePtr = bPrime.begin();
+    const solveScalar* const __restrict__ sourcePtr = source.begin();
+    solveScalar* __restrict__ accPtr = acc.begin();
 
     const scalar* const __restrict__ diagPtr = matrix_.diag().begin();
     const scalar* const __restrict__ upperPtr =
@@ -116,8 +146,6 @@ void Foam::GaussSeidelSmoother::smooth
 
     for (label sweep=0; sweep<nSweeps; sweep++)
     {
-        bPrime = source;
-
         const label startRequest = UPstream::nRequests();
 
         matrix_.initMatrixInterfaces
@@ -126,7 +154,7 @@ void Foam::GaussSeidelSmoother::smooth
             interfaceBouCoeffs_,
             interfaces_,
             psi,
-            bPrime,
+            acc,
             cmpt
         );
 
@@ -136,7 +164,7 @@ void Foam::GaussSeidelSmoother::smooth
             interfaceBouCoeffs_,
             interfaces_,
             psi,
-            bPrime,
+            acc,
             cmpt,
             startRequest
