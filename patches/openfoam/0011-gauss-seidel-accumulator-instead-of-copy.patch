@@ -151,8 +179,11 @@ void Foam::GaussSeidelSmoother::smooth
             fStart = fEnd;
             fEnd = ownStartPtr[celli + 1];
 
-            // Get the accumulated neighbour side
-            psii = bPrimePtr[celli];
+            // Add the source after the interface and lower-neighbour sum.
+            // All scatter targets have larger indices, so resetting here
+            // leaves the accumulator zero at the end of every sweep.
+            psii = sourcePtr[celli] + accPtr[celli];
+            accPtr[celli] = 0;
 
             // Accumulate the owner product side
             for (label facei=fStart; facei<fEnd; facei++)
@@ -166,7 +197,7 @@ void Foam::GaussSeidelSmoother::smooth
             // Distribute the neighbour side using psi for this cell
             for (label facei=fStart; facei<fEnd; facei++)
             {
-                bPrimePtr[uPtr[facei]] -= lowerPtr[facei]*psii;
+                accPtr[uPtr[facei]] -= lowerPtr[facei]*psii;
             }
 
             psiPtr[celli] = psii;
@@ -192,7 +223,8 @@ void Foam::GaussSeidelSmoother::smooth
         interfaceBouCoeffs_,
         interfaces_,
         cmpt,
-        nSweeps
+        nSweeps,
+        acc_
     );
 }
 
@@ -214,7 +246,8 @@ void Foam::GaussSeidelSmoother::scalarSmooth
