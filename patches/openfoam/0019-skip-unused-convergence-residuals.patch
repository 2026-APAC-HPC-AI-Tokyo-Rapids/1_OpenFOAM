 .../matrices/lduMatrix/solvers/PCG/PCG.C      | 69 +++++++++++---
 .../solvers/smoothSolver/smoothSolver.C       | 94 ++++++++++++++-----
 2 files changed, 128 insertions(+), 35 deletions(-)

diff --git a/src/OpenFOAM/matrices/lduMatrix/solvers/PCG/PCG.C b/src/OpenFOAM/matrices/lduMatrix/solvers/PCG/PCG.C
index 28f0bef1..84214760 100644
--- a/src/OpenFOAM/matrices/lduMatrix/solvers/PCG/PCG.C
+++ b/src/OpenFOAM/matrices/lduMatrix/solvers/PCG/PCG.C
@@ -139,6 +139,20 @@ Foam::solverPerformance Foam::PCG::scalarSolve
             );
         }
 
+        // Reference experiment: the bounds alone force the iteration count.
+        // Verbose convergence logging still needs every intermediate norm.
+        const bool fixedIter = minIter_ >= maxIter_ && maxIter_ > 0
+            && log_ < 2 && solverPerformance::debug < 2;
+        bool residualCurrent = true;
+        // checkConvergence also sets converged(). With nonzero tolerances,
+        // preserve its last observable value (at maxIter-1, or breakdown).
+        const auto needResidual = [&]()
+        {
+            return !fixedIter
+                || ((tolerance_ > 0 || relTol_ > 0)
+                 && solverPerf.nIterations() == maxIter_ - 2);
+        };
+
         // DIC is a fixed linear operator, as required by Chronopoulos/Gear
         // CG. Keep other (possibly variable) preconditioners on the old loop.
         if
@@ -155,7 +169,8 @@ Foam::solverPerformance Foam::PCG::scalarSolve
             // u = M^-1 r, w = A u. The two products concern the same r,
             // so they can share a reduction with its L1 norm. On the last
             // iteration only the norm is needed, with no extra M^-1 or A.
-            const auto reduceSums = [&](const bool nextDirection)
+            const auto reduceSums =
+            [&](const bool nextDirection, const bool residualNeeded)
             {
                 FixedList<solveScalar, 3> sums(Zero);
 
@@ -171,21 +186,23 @@ Foam::solverPerformance Foam::PCG::scalarSolve
                     {
                         sums[0] += uAPtr[cell]*rAPtr[cell];
                         sums[1] += wAPtr[cell]*uAPtr[cell];
-                        sums[2] += mag(rAPtr[cell]);
+                        if (residualNeeded) sums[2] += mag(rAPtr[cell]);
                     }
                 }
-                else
+                else if (residualNeeded)
                 {
                     sums[2] = sumMag(rA);
                 }
 
+                // Keep count/type/op/communicator identical: shrinking 3 to
+                // 2 can select a different MPI summation tree for CG scalars.
                 matrix_.mesh().reduce(sums, sumOp<solveScalar>());
                 return sums;
             };
 
             // Startup products for the first step. Subsequent products are
             // reduced after the update, alongside that step's residual norm.
-            FixedList<solveScalar, 3> sums = reduceSums(true);
+            FixedList<solveScalar, 3> sums = reduceSums(true, !fixedIter);
             solveScalar alpha = 0;
 
             // --- Solver iteration
@@ -234,12 +251,15 @@ Foam::solverPerformance Foam::PCG::scalarSolve
                 // this reduction. Prepare the next products speculatively,
                 // unless both iteration bounds already force a stop.
                 // minIter_ can require continuing even beyond maxIter_.
-                sums = reduceSums
-                (
+                const bool nextDirection =
                     solverPerf.nIterations() < maxIter_ - 1
-                 || solverPerf.nIterations() < minIter_ - 1
-                );
-                solverPerf.finalResidual() = sums[2]/normFactor;
+                 || solverPerf.nIterations() < minIter_ - 1;
+                residualCurrent = needResidual() || !nextDirection;
+                sums = reduceSums(nextDirection, residualCurrent);
+                if (residualCurrent)
+                {
+                    solverPerf.finalResidual() = sums[2]/normFactor;
+                }
 
             } while
             (
@@ -249,6 +269,10 @@ Foam::solverPerformance Foam::PCG::scalarSolve
                 )
              || solverPerf.nIterations() < minIter_
             );
+            if (!residualCurrent)
+            {
+                solverPerf.finalResidual() = reduceSums(false, true)[2]/normFactor;
+            }
         }
         else
         {
@@ -301,9 +325,13 @@ Foam::solverPerformance Foam::PCG::scalarSolve
                     rAPtr[cell] -= alpha*wAPtr[cell];
                 }
 
-                solverPerf.finalResidual() =
-                    gSumMag(rA, matrix().mesh().comm())
-                   /normFactor;
+                residualCurrent = needResidual();
+                if (residualCurrent)
+                {
+                    solverPerf.finalResidual() =
+                        gSumMag(rA, matrix().mesh().comm())
+                       /normFactor;
+                }
 
             } while
             (
@@ -313,6 +341,23 @@ Foam::solverPerformance Foam::PCG::scalarSolve
                 )
              || solverPerf.nIterations() < minIter_
             );
+
+            if (!residualCurrent)
+            {
+                solverPerf.finalResidual() =
+                    gSumMag(rA, matrix().mesh().comm())/normFactor;
+            }
+        }
+
+        if
+        (
+            fixedIter && !residualCurrent
+         && solverPerf.nIterations() > 0
+         && solverPerf.nIterations() < maxIter_
+        )
+        {
+            // A singularity break may expose an earlier convergence flag.
+            solverPerf.checkConvergence(tolerance_, relTol_, log_);
         }
     }
 
diff --git a/src/OpenFOAM/matrices/lduMatrix/solvers/smoothSolver/smoothSolver.C b/src/OpenFOAM/matrices/lduMatrix/solvers/smoothSolver/smoothSolver.C
