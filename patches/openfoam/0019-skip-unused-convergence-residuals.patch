--- a/src/OpenFOAM/matrices/lduMatrix/solvers/smoothSolver/smoothSolver.C
+++ b/src/OpenFOAM/matrices/lduMatrix/solvers/smoothSolver/smoothSolver.C
@@ -212,6 +212,21 @@ void internalResidual
     }
 }
 
+// With zero tolerances no residual can end the loop. Retain intermediate
+// residuals when checkConvergence prints them. Non-positive nSweeps keeps
+// its existing (including negative fixed-sweep) semantics.
+bool fixedIterations
+(
+    const Foam::scalar tolerance,
+    const Foam::scalar relTol,
+    const Foam::label nSweeps,
+    const int log
+)
+{
+    return nSweeps > 0 && tolerance == 0 && relTol == 0
+        && log < 2 && Foam::solverPerformance::debug < 2;
+}
+
 } // End anonymous namespace
 
 
@@ -365,9 +380,16 @@ Foam::solverPerformance Foam::smoothSolver::solve
                 acc.setSize(psi.size(), Zero);
             }
 
+            const bool fixedIter =
+                fixedIterations(tolerance_, relTol_, nSweeps_, log_);
+
             // Smoothing loop
             do
             {
+                const label nextIter = solverPerf.nIterations() + nSweeps_;
+                const bool needResidual =
+                    !fixedIter || (nextIter >= maxIter_ && nextIter >= minIter_);
+
                 if (fused)
                 {
                     const lduAddressing& addr = matrix_.lduAddr();
@@ -383,7 +405,7 @@ Foam::solverPerformance Foam::smoothSolver::solve
                             matrix_, interfaceBouCoeffs_, interfaces_, psi,
                             cmpt, acc
                         );
-                        if (sweep + 1 == nSweeps_)
