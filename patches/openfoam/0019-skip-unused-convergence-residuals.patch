                         {
                             smoothSolverDetail::gaussSeidelSweep<1, true>
                             (
@@ -412,7 +434,7 @@ Foam::solverPerformance Foam::smoothSolver::solve
                     (
                         matrix_, interfaceBouCoeffs_, interfaces_, psi, cmpt
                     );
-                    boundary->complete(residual);
+                    if (needResidual) boundary->complete(residual);
                 }
                 else
                 {
@@ -426,20 +448,26 @@ Foam::solverPerformance Foam::smoothSolver::solve
 
                     // Evaluate in place: the tmp-returning overload allocates a
                     // new field and the assignment then copies it into residual
-                    matrix_.residual
-                    (
-                        residual,
