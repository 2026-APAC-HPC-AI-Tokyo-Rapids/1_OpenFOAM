-                // Calculate the residual to check convergence
-                solverPerf.finalResidual() =
-                    gSumMag(residual, matrix().mesh().comm())/normFactor;
+                if (needResidual)
+                {
+                    // Final fixed-count norm, or a convergence-test norm
+                    solverPerf.finalResidual() =
