+                }
             } while
             (
                 (
@@ -542,12 +570,15 @@ void Foam::smoothSolver::solveGaussSeidelComponents
 
     // Components that still smooth, decided as in solve()
     List<bool> active(nCmpt);
+    List<bool> fixedIter(nCmpt);
     for (label k=0; k<nCmpt; k++)
     {
         const smoothSolver& s = *solvers[k];
         active[k] =
             s.minIter_ > 0
          || !solverPerf[k].checkConvergence(s.tolerance_, s.relTol_, s.log_);
+        fixedIter[k] =
