+Foam::scalarField& Foam::lduMatrix::upperUninitialised()
+{
+    if (!upperPtr_)
+    {
+        // The caller overwrites upper, including any symmetric values.
+        lowerCSRPtr_.reset(nullptr);
+        upperPtr_ =
+            std::make_unique<scalarField>(lduAddr().lowerAddr().size());
+    }
+
+    return *upperPtr_;
+}
+
+
+Foam::scalarField& Foam::lduMatrix::lowerUninitialised()
+{
+    if (!lowerPtr_)
+    {
+        lowerCSRPtr_.reset(nullptr);
+        lowerPtr_ =
+            std::make_unique<scalarField>(lduAddr().lowerAddr().size());
+    }
+
+    return *lowerPtr_;
+}
