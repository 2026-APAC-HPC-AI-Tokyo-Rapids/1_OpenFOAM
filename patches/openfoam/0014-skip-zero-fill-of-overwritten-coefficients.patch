 }
 
 
+template<class Type>
+Foam::SolverPerformance<Type> Foam::fvMatrix<Type>::solveWithSource
+(
+    const tmp<GeometricField<Type, fvPatchField, volMesh>>& rhs
+)
+{
+    checkMethod(*this, rhs(), "==");
+
+    if constexpr
+    (
+        std::is_same<Type, vector>::value
+     && std::is_same<solveScalar, scalar>::value
+    )
+    {
+        const dictionary& controls = solverDict();
+
+        // Exactly the component-combined solveSegregated path above: it
+        // builds separate component diagonals and restores diag after
+        // initial residuals; all other coefficients are read only.
+        // Exclude virtual fvMesh::solve overrides.
+        if
+        (
+            !useImplicit_
+         && !nMatrix_
+         && isType<fvMesh>(psi_.mesh())
+         && controls.getOrDefault<word>("type", "segregated") == "segregated"
+         && cmptMin(psi_.mesh().template validComponents<Type>()) != -1
+         && controls.get<word>("solver") == smoothSolver::typeName
+         && lduMatrix::smoother::getName(controls)
+            == GaussSeidelSmoother::typeName
+         && controls.getOrDefault<label>("nSweeps", 1) > 0
+        )
+        {
+            // Preserve the source by copying it, just as operator== does.
+            // Restore by transfer, not by subtracting the RHS (roundoff).
+            Field<Type> savedSource(source_);
+            source_ += rhs().mesh().V()*rhs().primitiveField();
+            rhs.clear();
+            const auto perf = solve(controls);
+            source_.transfer(savedSource);
+            return perf;
+        }
+    }
+
+    return Foam::solve(*this == rhs);
+}
