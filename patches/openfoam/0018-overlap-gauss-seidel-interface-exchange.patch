+/*---------------------------------------------------------------------------*\
+    OpenFOAM: The Open Source CFD Toolbox
+    SPDX-License-Identifier: GPL-3.0-or-later
+\*---------------------------------------------------------------------------*/
+
+#ifndef Foam_gaussSeidelInterfaceOrder_H
+#define Foam_gaussSeidelInterfaceOrder_H
+
+#include "lduMatrix.H"
+#include "labelRange.H"
+#include "boolList.H"
+
+namespace Foam
+{
+
+// Cached interior-first ordering for a fixed matrix and coupled interfaces.
+// Rows keep original cell labels. Edges point forward in the sweep order,
+// which need not be the numerical order of their cell labels.
+class gaussSeidelInterfaceOrder
+{
+    List<labelRange> interiorRanges_;
+    List<labelRange> interfaceRanges_;
+    labelList ownerStart_;
+    labelList neighbour_;
+    scalarField upper_;
+    scalarField lower_;
+
+public:
+
+    static boolList interfaceCells
+    (
+        const lduMatrix& matrix,
+        const lduInterfaceFieldPtrsList& interfaces
+    );
+
+    gaussSeidelInterfaceOrder
+    (
+        const lduMatrix& matrix,
+        const boolList& isInterface
+    );
+
+    const List<labelRange>& interiorRanges() const { return interiorRanges_; }
+    const List<labelRange>& interfaceRanges() const { return interfaceRanges_; }
+
+    // Reuse the original arrays unless some edges reverse direction.
+    const labelUList& ownerStart(const lduMatrix& matrix) const
+    {
+        if (ownerStart_.empty()) return matrix.lduAddr().ownerStartAddr();
+        return ownerStart_;
+    }
+
+    const labelUList& neighbour(const lduMatrix& matrix) const
+    {
+        if (ownerStart_.empty()) return matrix.lduAddr().upperAddr();
+        return neighbour_;
+    }
+
+    const scalarField& upper(const lduMatrix& matrix) const
+    {
+        return ownerStart_.empty() ? matrix.upper() : upper_;
+    }
+
+    const scalarField& lower(const lduMatrix& matrix) const
+    {
+        return ownerStart_.empty() ? matrix.lower() : lower_;
+    }
+};
+
+} // End namespace Foam
+
+#endif
+
