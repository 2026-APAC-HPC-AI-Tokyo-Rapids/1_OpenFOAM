+// * * * * * * * * * * * * * * Cached Sweep Addressing * * * * * * * * * * //
+
+Foam::boolList Foam::gaussSeidelInterfaceOrder::interfaceCells
+(
+    const lduMatrix& matrix,
+    const lduInterfaceFieldPtrsList& interfaces
+)
+{
+    boolList isInterface(matrix.diag().size(), false);
+    forAll(interfaces, patchi)
+    {
+        if (interfaces.set(patchi))
+        {
+            // Includes processor, cyclic and agglomerated GAMG interfaces.
+            for (const label celli : matrix.lduAddr().patchAddr(patchi))
+            {
+                isInterface[celli] = true;
+            }
+        }
+    }
+    return isInterface;
+}
+
+
+Foam::gaussSeidelInterfaceOrder::gaussSeidelInterfaceOrder
+(
+    const lduMatrix& matrix,
+    const boolList& isInterface
+)
+{
+    const label nCells = matrix.diag().size();
+
+    // Other communication modes retain the original ordering.
+    if (UPstream::defaultCommsType != UPstream::commsTypes::nonBlocking)
+    {
+        interfaceRanges_ = List<labelRange>(1, labelRange(0, nCells));
+        return;
+    }
+
+    DynamicList<labelRange> interiorRanges;
+    DynamicList<labelRange> interfaceRanges;
+    for (label begin=0; begin<nCells; )
+    {
+        label end = begin + 1;
+        while (end<nCells && isInterface[end] == isInterface[begin]) ++end;
+        if (isInterface[begin])
+        {
+            interfaceRanges.append(labelRange(begin, end - begin));
+        }
+        else
+        {
+            interiorRanges.append(labelRange(begin, end - begin));
+        }
+        begin = end;
+    }
+
+    // With no coupled faces, keep init/update before the original full sweep.
+    // In particular, serial uncoupled runs are bit-identical to 034b3ffd.
+    if (interfaceRanges.empty())
+    {
+        interfaceRanges_ = List<labelRange>(1, labelRange(0, nCells));
+        return;
+    }
+    interiorRanges_ = interiorRanges;
+    interfaceRanges_ = interfaceRanges;
+
+    const labelUList& l = matrix.lduAddr().lowerAddr();
+    const labelUList& u = matrix.lduAddr().upperAddr();
+    bool reverse = false;
+    forAll(l, facei)
+    {
+        if (isInterface[l[facei]] && !isInterface[u[facei]])
+        {
+            reverse = true;
+            break;
+        }
+    }
+    if (!reverse) return;
+
+    // A boundary owner can follow its interior neighbour in the new order.
+    // Reverse that edge AND swap its coefficients: gather the old boundary
+    // value at the interior cell, then scatter the new interior value back
+    // to the boundary accumulator. Every edge still has two products.
+    ownerStart_.setSize(nCells + 1, Zero);
+    forAll(l, facei)
+    {
+        const bool flip = isInterface[l[facei]] && !isInterface[u[facei]];
+        ++ownerStart_[(flip ? u[facei] : l[facei]) + 1];
+    }
+    for (label celli=0; celli<nCells; ++celli)
+    {
+        ownerStart_[celli + 1] += ownerStart_[celli];
+    }
+    labelList next(ownerStart_);
+    neighbour_.setSize(l.size());
+    upper_.setSize(l.size());
+    lower_.setSize(l.size());
+    const scalarField& upper = matrix.upper();
+    const scalarField& lower = matrix.lower();
+    forAll(l, facei)
+    {
+        const bool flip = isInterface[l[facei]] && !isInterface[u[facei]];
+        const label row = flip ? u[facei] : l[facei];
+        const label slot = next[row]++;
+        neighbour_[slot] = flip ? l[facei] : u[facei];
+        upper_[slot] = flip ? lower[facei] : upper[facei];
+        lower_[slot] = flip ? upper[facei] : lower[facei];
+    }
+}
