+// One GaussSeidel sweep of N components that share the off-diagonal
+// coefficients and the addressing. Per component the operations and their
+// order are those of GaussSeidelSmoother::smooth.
+template<int N>
+void gaussSeidelSweep
+(
+    const Foam::label nCells,
+    const Foam::label* const __restrict__ ownStartPtr,
+    const Foam::label* const __restrict__ uPtr,
+    const Foam::scalar* const __restrict__ upperPtr,
+    const Foam::scalar* const __restrict__ lowerPtr,
+    const Foam::scalar* const diagPtr[N],
+    Foam::solveScalar* const psiPtr[N],
+    Foam::solveScalar* const bPrimePtr[N]
+)
+{
+    using namespace Foam;
+
+    solveScalar psii[N];
+    label fStart;
+    label fEnd = ownStartPtr[0];
+
+    for (label celli=0; celli<nCells; celli++)
+    {
+        // Start and end of this row
+        fStart = fEnd;
+        fEnd = ownStartPtr[celli + 1];
+
+        // Get the accumulated neighbour side
+        for (int k=0; k<N; k++)
+        {
+            psii[k] = bPrimePtr[k][celli];
+        }
+
+        // Accumulate the owner product side
+        for (label facei=fStart; facei<fEnd; facei++)
+        {
+            const scalar a = upperPtr[facei];
+            const label j = uPtr[facei];
+            for (int k=0; k<N; k++)
+            {
+                psii[k] -= a*psiPtr[k][j];
+            }
+        }
+
+        // Finish psi for this cell
+        for (int k=0; k<N; k++)
+        {
+            psii[k] /= diagPtr[k][celli];
+        }
+
+        // Distribute the neighbour side using psi for this cell
+        for (label facei=fStart; facei<fEnd; facei++)
+        {
+            const scalar a = lowerPtr[facei];
+            const label j = uPtr[facei];
+            for (int k=0; k<N; k++)
+            {
+                bPrimePtr[k][j] -= a*psii[k];
+            }
+        }
+
+        for (int k=0; k<N; k++)
+        {
+            psiPtr[k][celli] = psii[k];
+        }
+    }
+}
+
+
+// The internal part of lduMatrix::residual for N components that share the
+// off-diagonal coefficients and the addressing, with the same operations
+// and order per component. The interface contributions are added afterwards.
+template<int N>
+void internalResidual
+(
+    const Foam::label nCells,
+    const Foam::label nFaces,
+    const Foam::label* const __restrict__ lPtr,
+    const Foam::label* const __restrict__ uPtr,
+    const Foam::scalar* const __restrict__ upperPtr,
+    const Foam::scalar* const __restrict__ lowerPtr,
+    const Foam::scalar* const diagPtr[N],
+    const Foam::solveScalar* const psiPtr[N],
+    const Foam::solveScalar* const sourcePtr[N],
+    Foam::solveScalar* const rAPtr[N]
+)
+{
+    using namespace Foam;
+
+    for (label cell=0; cell<nCells; cell++)
+    {
+        for (int k=0; k<N; k++)
+        {
+            rAPtr[k][cell] = sourcePtr[k][cell] - diagPtr[k][cell]*psiPtr[k][cell];
+        }
+    }
+
+    for (label face=0; face<nFaces; face++)
+    {
+        const label l = lPtr[face];
+        const label u = uPtr[face];
+        const scalar lower = lowerPtr[face];
+        const scalar upper = upperPtr[face];
+        for (int k=0; k<N; k++)
+        {
+            rAPtr[k][u] -= lower*psiPtr[k][l];
+            rAPtr[k][l] -= upper*psiPtr[k][u];
+        }
+    }
+}
+
+} // End anonymous namespace
