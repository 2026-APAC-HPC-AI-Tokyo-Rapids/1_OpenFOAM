 // ************************************************************************* //
+
+
+void Foam::smoothSolver::solveGaussSeidelComponents
+(
+    lduMatrix& matrix,
+    const UList<const smoothSolver*>& solvers,
+    const UList<const scalarField*>& diag,
+    const UList<scalarField*>& psi,
+    const UList<const scalarField*>& source,
+    UList<solverPerformance>& solverPerf
+)
+{
+    static_assert
+    (
+        std::is_same<solveScalar, scalar>::value,
+        "component smoothing works on the scalarField of each component"
+    );
+
+    const label nCmpt = solvers.size();
+    if (nCmpt != 3)
+    {
+        FatalErrorInFunction
+            << "Expected 3 components, got " << nCmpt << abort(FatalError);
+    }
+
+    const label nSweeps = solvers[0]->nSweeps_;
+    const label comm = matrix.mesh().comm();
+
+    // Initial residuals, as in solve(), with the diagonal of each component
+    scalarField& matrixDiag = matrix.diag();
+    const scalarField saveDiag(matrixDiag);
+    List<solveScalar> normFactor(nCmpt);
+    PtrList<solveScalarField> residual(nCmpt);
+
+    for (label k=0; k<nCmpt; k++)
+    {
+        const smoothSolver& s = *solvers[k];
+
+        if (s.nSweeps_ != nSweeps)
+        {
+            FatalErrorInFunction
+                << "Components with different nSweeps" << abort(FatalError);
+        }
+
+        matrixDiag = *diag[k];
+        solverPerf[k] = solverPerformance(typeName, s.fieldName_);
+        residual.set(k, new solveScalarField());
+
+        {
+            solveScalarField Apsi(psi[k]->size());
+            solveScalarField temp(psi[k]->size());
+
+            // Calculate A.psi
+            matrix.Amul(Apsi, *psi[k], s.interfaceBouCoeffs_, s.interfaces_, k);
+
+            // Calculate normalisation factor
+            normFactor[k] = s.normFactor(*psi[k], *source[k], Apsi, temp);
+
+            residual[k] = *source[k] - Apsi;
+
+            matrix.setResidualField(residual[k], s.fieldName_, true);
+
+            // Calculate residual magnitude
+            solverPerf[k].initialResidual() =
+                gSumMag(residual[k], comm)/normFactor[k];
+            solverPerf[k].finalResidual() = solverPerf[k].initialResidual();
+        }
+
+        if ((s.log_ >= 2) || (lduMatrix::debug >= 2))
+        {
+            Info.masterStream(comm)
+                << "   Normalisation factor = " << normFactor[k] << endl;
+        }
+    }
+
+    matrixDiag = saveDiag;
+
+    // Components that still smooth, decided as in solve()
+    List<bool> active(nCmpt);
+    for (label k=0; k<nCmpt; k++)
+    {
+        const smoothSolver& s = *solvers[k];
+        active[k] =
+            s.minIter_ > 0
+         || !solverPerf[k].checkConvergence(s.tolerance_, s.relTol_, s.log_);
+    }
+
+    // Coefficients and addressing through the const matrix, as the smoother
+    // and lduMatrix::residual read them
+    const lduMatrix& cmatrix = matrix;
+    const label nCells = saveDiag.size();
+    const label nFaces = cmatrix.upper().size();
+    const label* const ownStartPtr =
+        cmatrix.lduAddr().ownerStartAddr().begin();
+    const label* const uPtr = cmatrix.lduAddr().upperAddr().begin();
+    const label* const lPtr = cmatrix.lduAddr().lowerAddr().begin();
+    const scalar* const upperPtr = cmatrix.upper().begin();
+    const scalar* const lowerPtr = cmatrix.lower().begin();
+
+    PtrList<solveScalarField> bPrime(nCmpt);
+    for (label k=0; k<nCmpt; k++)
+    {
+        bPrime.set(k, new solveScalarField(nCells));
+    }
+
+    while (active[0] || active[1] || active[2])
+    {
+        // All three components share one pass while all of them smooth; once
+        // some have converged, the others go through the same kernels one at
+        // a time (the operations per component do not depend on the grouping)
+        const bool together = active[0] && active[1] && active[2];
+
+        for (label sweep=0; sweep<nSweeps; sweep++)
+        {
+            for (label k=0; k<nCmpt; k++)
+            {
+                if (!active[k]) continue;
+
+                const smoothSolver& s = *solvers[k];
+                bPrime[k] = *source[k];
+
+                const label startRequest = UPstream::nRequests();
+
+                matrix.initMatrixInterfaces
+                (
+                    false,
+                    s.interfaceBouCoeffs_,
+                    s.interfaces_,
+                    *psi[k],
+                    bPrime[k],
+                    k
+                );
+
+                matrix.updateMatrixInterfaces
+                (
+                    false,
+                    s.interfaceBouCoeffs_,
+                    s.interfaces_,
+                    *psi[k],
+                    bPrime[k],
+                    k,
+                    startRequest
+                );
+            }
+
+            if (together)
+            {
+                const scalar* d[3] = {diag[0]->cdata(), diag[1]->cdata(), diag[2]->cdata()};
+                solveScalar* p[3] = {psi[0]->data(), psi[1]->data(), psi[2]->data()};
+                solveScalar* b[3] = {bPrime[0].data(), bPrime[1].data(), bPrime[2].data()};
+                gaussSeidelSweep<3>(nCells, ownStartPtr, uPtr, upperPtr, lowerPtr, d, p, b);
+            }
+            else
+            {
+                for (label k=0; k<nCmpt; k++)
+                {
+                    if (!active[k]) continue;
+                    const scalar* d[1] = {diag[k]->cdata()};
+                    solveScalar* p[1] = {psi[k]->data()};
+                    solveScalar* b[1] = {bPrime[k].data()};
+                    gaussSeidelSweep<1>(nCells, ownStartPtr, uPtr, upperPtr, lowerPtr, d, p, b);
+                }
+            }
+        }
+
+        // Residuals: internal part for all active components, then the
+        // interface contributions of each component in turn
+        if (together)
+        {
+            const scalar* d[3] = {diag[0]->cdata(), diag[1]->cdata(), diag[2]->cdata()};
+            const solveScalar* p[3] = {psi[0]->cdata(), psi[1]->cdata(), psi[2]->cdata()};
+            const solveScalar* b[3] = {source[0]->cdata(), source[1]->cdata(), source[2]->cdata()};
+            solveScalar* r[3] = {residual[0].data(), residual[1].data(), residual[2].data()};
+            internalResidual<3>(nCells, nFaces, lPtr, uPtr, upperPtr, lowerPtr, d, p, b, r);
+        }
+        else
+        {
+            for (label k=0; k<nCmpt; k++)
+            {
+                if (!active[k]) continue;
+                const scalar* d[1] = {diag[k]->cdata()};
+                const solveScalar* p[1] = {psi[k]->cdata()};
+                const solveScalar* b[1] = {source[k]->cdata()};
+                solveScalar* r[1] = {residual[k].data()};
+                internalResidual<1>(nCells, nFaces, lPtr, uPtr, upperPtr, lowerPtr, d, p, b, r);
+            }
+        }
+
+        for (label k=0; k<nCmpt; k++)
+        {
+            if (!active[k]) continue;
+
+            const smoothSolver& s = *solvers[k];
+            const label startRequest = UPstream::nRequests();
+
+            matrix.initMatrixInterfaces
+            (
+                false,
+                s.interfaceBouCoeffs_,
+                s.interfaces_,
+                *psi[k],
+                residual[k],
+                k
+            );
+
+            matrix.updateMatrixInterfaces
+            (
+                false,
+                s.interfaceBouCoeffs_,
+                s.interfaces_,
+                *psi[k],
+                residual[k],
+                k,
+                startRequest
+            );
+        }
+
+        for (label k=0; k<nCmpt; k++)
+        {
+            if (!active[k]) continue;
+
+            const smoothSolver& s = *solvers[k];
+
+            // Calculate the residual to check convergence
+            solverPerf[k].finalResidual() =
+                gSumMag(residual[k], comm)/normFactor[k];
+
+            active[k] =
+            (
+                (solverPerf[k].nIterations() += nSweeps) < s.maxIter_
+             && !solverPerf[k].checkConvergence(s.tolerance_, s.relTol_, s.log_)
+            )
+         || solverPerf[k].nIterations() < s.minIter_;
+        }
+    }
+
+    for (label k=0; k<nCmpt; k++)
+    {
+        matrix.setResidualField(residual[k], solvers[k]->fieldName_, false);
+    }
+}
