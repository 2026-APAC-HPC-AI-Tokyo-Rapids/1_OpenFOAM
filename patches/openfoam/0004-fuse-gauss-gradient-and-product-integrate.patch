+template<class Type>
+void Foam::fv::gaussGrad<Type>::addLinearFaceSums
+(
+    Field<typename outerProduct<vector, Type>::type>& igGrad,
+    const GeometricField<Type, fvPatchField, volMesh>& vsf
+)
+{
+    typedef typename outerProduct<vector, Type>::type GradType;
+
+    const fvMesh& mesh = vsf.mesh();
+    const labelUList& owner = mesh.owner();
+    const labelUList& neighbour = mesh.neighbour();
+    const vectorField& Sf = mesh.Sf();
+    const surfaceScalarField& lambdas = mesh.surfaceInterpolation::weights();
+    const scalarField& lambda = lambdas;
+    const Field<Type>& vfi = vsf;
+
+    forAll(owner, facei)
+    {
+        const Type ssf =
+            lambda[facei]*(vfi[owner[facei]] - vfi[neighbour[facei]])
+          + vfi[neighbour[facei]];
+
+        const GradType Sfssf = Sf[facei]*ssf;
+
+        igGrad[owner[facei]] += Sfssf;
+        igGrad[neighbour[facei]] -= Sfssf;
+    }
+
+    forAll(mesh.boundary(), patchi)
+    {
+        const labelUList& pFaceCells =
+            mesh.boundary()[patchi].faceCells();
+
+        const vectorField& pSf = mesh.Sf().boundaryField()[patchi];
+
+        const fvPatchField<Type>& pvf = vsf.boundaryField()[patchi];
+
+        if (pvf.coupled())
+        {
+            const Field<Type> pssf
+            (
+                lerp
+                (
+                    pvf.patchNeighbourField(),
+                    pvf.patchInternalField(),
+                    lambdas.boundaryField()[patchi]
+                )
+            );
+
+            forAll(mesh.boundary()[patchi], facei)
+            {
+                igGrad[pFaceCells[facei]] += pSf[facei]*pssf[facei];
+            }
+        }
+        else
+        {
+            forAll(mesh.boundary()[patchi], facei)
+            {
+                igGrad[pFaceCells[facei]] += pSf[facei]*pvf[facei];
+            }
+        }
+    }
+}
+
