+template<class Type>
+tmp<DimensionedField<Type, volMesh>>
+surfaceIntegrateInternal
+(
+    const surfaceScalarField& a,
+    const tmp<GeometricField<Type, fvsPatchField, surfaceMesh>>& tb
+)
+{
+    const GeometricField<Type, fvsPatchField, surfaceMesh>& b = tb();
+    const fvMesh& mesh = b.mesh();
+
+    auto tvf = tmp<DimensionedField<Type, volMesh>>::New
+    (
+        IOobject
+        (
+            "surfaceIntegrate("+a.name()+'*'+b.name()+')',
+            b.instance(),
+            mesh,
+            IOobject::NO_READ,
+            IOobject::NO_WRITE,
+            IOobject::NO_REGISTER
+        ),
+        mesh,
+        dimensioned<Type>(a.dimensions()*b.dimensions()/dimVol, Zero)
+    );
+    Field<Type>& ivf = tvf.ref().field();
+
+    const labelUList& owner = mesh.owner();
+    const labelUList& neighbour = mesh.neighbour();
+
+    const scalarField& ia = a;
+    const Field<Type>& ib = b;
+
+    forAll(owner, facei)
+    {
+        const Type abf = ia[facei]*ib[facei];
+
+        ivf[owner[facei]] += abf;
+        ivf[neighbour[facei]] -= abf;
+    }
+
+    forAll(mesh.boundary(), patchi)
+    {
+        const labelUList& pFaceCells =
+            mesh.boundary()[patchi].faceCells();
+
+        const fvsPatchScalarField& pa = a.boundaryField()[patchi];
+        const fvsPatchField<Type>& pb = b.boundaryField()[patchi];
+
+        forAll(mesh.boundary()[patchi], facei)
+        {
+            ivf[pFaceCells[facei]] += pa[facei]*pb[facei];
+        }
+    }
+
+    ivf /= mesh.Vsc();
+
+    tb.clear();
+    return tvf;
+}
+
