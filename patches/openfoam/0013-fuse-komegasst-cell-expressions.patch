+template<class BasicEddyViscosityModel>
+tmp<volScalarField> kOmegaSSTBase<BasicEddyViscosityModel>::blend
+(
+    const volScalarField& F1,
+    const dimensionedScalar& psi1,
+    const dimensionedScalar& psi2
+) const
+{
+    if (!sstCellAlgebra(this->mesh_))
+    {
+        return F1*(psi1 - psi2) + psi2;
+    }
+    const scalar delta = (psi1 - psi2).value();
+    return sstScalarField
+    (
+        "blend", this->mesh_, psi2.dimensions(),
+        [&](scalar f) { return sstBlend(f, delta, psi2.value()); }, F1
+    );
+}
+
+
+template<class BasicEddyViscosityModel>
+tmp<volScalarField::Internal> kOmegaSSTBase<BasicEddyViscosityModel>::blend
+(
+    const volScalarField::Internal& F1,
+    const dimensionedScalar& psi1,
+    const dimensionedScalar& psi2
+) const
+{
+    const scalar delta = (psi1 - psi2).value();
+    return sstInternalField
+    (
+        "blend", this->mesh_, psi2.dimensions(),
+        [&](scalar f) { return sstBlend(f, delta, psi2.value()); }, F1
+    );
+}
+
+
+template<class BasicEddyViscosityModel>
+tmp<volScalarField> kOmegaSSTBase<BasicEddyViscosityModel>::diffusivity
+(
+    const word& name,
+    const volScalarField& F1,
+    const dimensionedScalar& psi1,
+    const dimensionedScalar& psi2
+) const
+{
+    if (!sstCellAlgebra(this->mesh_))
+    {
+        return tmp<volScalarField>::New
+        (
+            name, blend(F1, psi1, psi2)*this->nut_ + this->nu()
+        );
+    }
+    const tmp<volScalarField> tnu(this->nu());
+    const scalar delta = (psi1 - psi2).value();
+    return sstScalarField
+    (
+        name, this->mesh_, this->nut_.dimensions(),
+        [&](scalar f, scalar nut, scalar nu)
+        {
+            const scalar alpha = sstBlend(f, delta, psi2.value());
+            const volatile scalar product = alpha*nut;
+            return product + nu;
+        },
+        F1, this->nut_, tnu()
+    );
+}
+
+
+template<class BasicEddyViscosityModel>
+tmp<volScalarField> kOmegaSSTBase<BasicEddyViscosityModel>::DkEff
+(
+    const volScalarField& F1
+) const
+{
+    return diffusivity("DkEff", F1, alphaK1_, alphaK2_);
+}
+
+
+template<class BasicEddyViscosityModel>
+tmp<volScalarField> kOmegaSSTBase<BasicEddyViscosityModel>::DomegaEff
+(
+    const volScalarField& F1
+) const
+{
+    return diffusivity("DomegaEff", F1, alphaOmega1_, alphaOmega2_);
+}
