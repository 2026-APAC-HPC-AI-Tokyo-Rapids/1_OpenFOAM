+// Algebra on processor patches uses the stored patch values, not an exchange.
+// Other coupled patches can evaluateLocal() after every operator. Keep their
+// original expression trees: evaluating only the final result is not equivalent.
+inline bool sstCellAlgebra(const fvMesh& mesh)
+{
+    if (FieldBase::localBoundaryConsistency())
+    {
+        for (const fvPatch& patch : mesh.boundary())
+        {
+            if (patch.coupled() && !isA<processorFvPatch>(patch))
+            {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+
+// One cell pass and one pass over the stored values of each patch. New() uses
+// the same calculated/constraint patch types as the original field operators.
+template<class Op, class... Fields>
+tmp<volScalarField> sstScalarField
+(
+    const word& name,
+    const fvMesh& mesh,
+    const dimensionSet& dimensions,
+    const Op& op,
+    const Fields&... fields
+)
+{
+    auto result = volScalarField::New(name, mesh, dimensions);
+    scalarField& cells = result.ref().primitiveFieldRef();
+    forAll(cells, celli)
+    {
+        cells[celli] = op(fields.primitiveField()[celli]...);
+    }
+
+    auto& boundary = result.ref().boundaryFieldRef();
+    forAll(boundary, patchi)
+    {
+        scalarField& patch = boundary[patchi];
+        forAll(patch, facei)
+        {
+            patch[facei] = op(fields.boundaryField()[patchi][facei]...);
+        }
+    }
+    result.ref().correctLocalBoundaryConditions();
+    if (volScalarField::Boundary::debug)
+    {
+        result().boundaryField().check();
+    }
+    return result;
+}
+
+
+template<class Op, class... Fields>
+tmp<volScalarField::Internal> sstInternalField
+(
+    const word& name,
+    const fvMesh& mesh,
+    const dimensionSet& dimensions,
+    const Op& op,
+    const Fields&... fields
+)
+{
+    auto result = volScalarField::Internal::New(name, mesh, dimensions);
+    scalarField& cells = result.ref();
+    forAll(cells, celli)
+    {
+        cells[celli] = op(fields[celli]...);
+    }
+    return result;
+}
+
+
+// Field multiplication and addition are separate loops in the original.
+// Force the product to round before adding, even with -ffp-contract=fast.
+inline scalar sstBlend(const scalar f, const scalar delta, const scalar psi2)
+{
+    const volatile scalar product = f*delta;
+    return product + psi2;
+}
+
+
+inline tmp<volScalarField> sstCDkOmega
+(
+    const tmp<volVectorField>& tgradK,
+    const tmp<volVectorField>& tgradOmega,
+    const dimensionedScalar& coefficient,
+    const volScalarField& omega
+)
+{
+    if (!sstCellAlgebra(omega.mesh()))
+    {
+        return coefficient*(tgradK & tgradOmega)/omega;
+    }
+
+    auto result = sstScalarField
+    (
+        "CDkOmega", omega.mesh(), dimless/sqr(dimTime),
+        [&](const vector& gk, const vector& go, const scalar w)
+        {
+            return (coefficient.value()*(gk & go))/w;
+        },
+        tgradK(), tgradOmega(), omega
+    );
+    tgradK.clear();
+    tgradOmega.clear();
+    return result;
+}
+
