diff --git a/src/finiteVolume/finiteVolume/fvc/fvcSurfaceIntegrate.C b/src/finiteVolume/finiteVolume/fvc/fvcSurfaceIntegrate.C
index e77a0731..b6bcdc15 100644
--- a/src/finiteVolume/finiteVolume/fvc/fvcSurfaceIntegrate.C
+++ b/src/finiteVolume/finiteVolume/fvc/fvcSurfaceIntegrate.C
@@ -129,6 +129,52 @@ surfaceIntegrate
 }
 
 
+template<class Type>
+tmp<DimensionedField<Type, volMesh>>
+surfaceIntegrateInternal
+(
+    const GeometricField<Type, fvsPatchField, surfaceMesh>& ssf
+)
+{
+    const fvMesh& mesh = ssf.mesh();
+
+    auto tvf = tmp<DimensionedField<Type, volMesh>>::New
+    (
+        IOobject
+        (
+            "surfaceIntegrate("+ssf.name()+')',
+            ssf.instance(),
+            mesh,
+            IOobject::NO_READ,
+            IOobject::NO_WRITE,
+            IOobject::NO_REGISTER
+        ),
+        mesh,
+        dimensioned<Type>(ssf.dimensions()/dimVol, Zero)
+    );
+
+    surfaceIntegrate(tvf.ref().field(), ssf);
+
+    return tvf;
+}
+
+
+template<class Type>
+tmp<DimensionedField<Type, volMesh>>
+surfaceIntegrateInternal
+(
+    const tmp<GeometricField<Type, fvsPatchField, surfaceMesh>>& tssf
+)
+{
+    tmp<DimensionedField<Type, volMesh>> tvf
+    (
+        fvc::surfaceIntegrateInternal(tssf())
+    );
+    tssf.clear();
+    return tvf;
+}
+
