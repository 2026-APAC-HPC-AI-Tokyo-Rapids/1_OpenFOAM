#!/bin/bash
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=120gb
#PBS -l walltime=00:30:00
#PBS -j oe
#
# Diagnostic run for Issue #62, not a benchmark: submission/openfoam/run/prepare.pbs for the baseline, the case-default
# hierarchical split. It replaces run/prepare.pbs in a copy of the submission scripts. The only difference: the method
# stays hierarchical, so nHierarchical keeps the case's own (16 8 4) on 4 nodes. solve.pbs sets endTime to 40.
#   cp controlDict.noWrite and fvSolution.fixedIter, decomposePar -constant, restore0Dir -processor
set -euo pipefail
source "${SCRIPT_DIR}/environment.sh"
[[ "${NODES}" == 4 ]]

mkdir -p "${CASE_DIR}/logFiles"
cp -a "${CASE_SOURCE}/." "${CASE_DIR}/"
cd "${CASE_DIR}"
tar -xzf "${MESH_ARCHIVE}" -C constant
cp system/controlDict.noWrite system/controlDict
cp system/fvSolution.fixedIter system/fvSolution
sed -i -E "s/^(nCores[[:space:]]+)[0-9]+;/\\1512;/; s/^(decompositionMethod[[:space:]]+)[^;]+;/\\1hierarchical;/" system/include/caseDefinition
grep -Eq '^nHierarchical[[:space:]]+\(16 8 4\);' system/include/caseDefinition

decomposePar -constant -fileHandler uncollated > logFiles/10_decomposePar.log 2>&1
restore0Dir -processor
