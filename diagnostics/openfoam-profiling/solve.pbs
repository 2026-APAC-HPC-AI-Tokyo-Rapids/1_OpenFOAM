#!/bin/bash
#PBS -q normal
#PBS -l place=excl
#PBS -l walltime=00:40:00
#PBS -j oe
#
# Diagnostic run for Issue #62, not a benchmark: submission/openfoam/run/solve.pbs for the baseline, with OpenFOAM's
# built-in profiling. It replaces run/solve.pbs in a copy of the submission scripts, so that run/submit.sh starts it after
# prepare.pbs. Differences from solve.pbs:
#   - Placement of the baseline: only the launcher's CPU binding (--cpu-bind depth -d 1), which is lost during MPI_Init.
#     No numactl --membind wrapper and no taskset keeper.
#   - controlDict: endTime and writeInterval 40, so that every rank writes <case>/processor*/40/uniform/profiling once;
#     `profiling {}`; the parProfiling function object (Pstream times of every rank, reported once at the end).
#   - observe-placement.sh reads, once the solver iterates, the CPU affinity and NUMA page placement of every rank.
#   - Afterwards every node copies the profiling file of each of its ranks back to CASE_DIR.
set -euo pipefail
source "${SCRIPT_DIR}/environment.sh"
ranks=$(( NODES * 128 ))

sed -i -E 's/^(endTime[[:space:]]+)[0-9]+;/\140;/; s/^(writeInterval[[:space:]]+)[0-9]+;/\140;/' "${CASE_DIR}/system/controlDict"
sed -i -E 's|^(    #include "wallShearStress")$|\1\n    parProfiling\n    {\n        type            parProfiling;\n        libs            (utilityFunctionObjects);\n        detail          1;\n        executeControl  onEnd;\n        writeControl    none;\n    }|' "${CASE_DIR}/system/controlDict"
printf '\nprofiling\n{\n    active      true;\n    cpuInfo     false;\n    memInfo     false;\n    sysInfo     false;\n}\n' >> "${CASE_DIR}/system/controlDict"
grep -q 'type            parProfiling;' "${CASE_DIR}/system/controlDict"
cp "${CASE_DIR}/system/controlDict" "${CASE_DIR}/logFiles/controlDict.diagnostic"

mpiexec -n "${NODES}" -ppn 1 cp -a "${CASE_DIR}" "${TMPDIR}/"
options=(-parallel -fileHandler uncollated)
if (( NODES > 1 )); then options+=(-hostRoots "((\".*\" \"${TMPDIR}\"))" -ioRanks "($(seq -s ' ' 0 128 $(( ranks - 1 ))))"); fi

launch=(mpiexec -n "${ranks}" -ppn 128 --cpu-bind depth -d 1)

local_case="${TMPDIR}/$(basename "${CASE_DIR}")"
cd "${local_case}"
"${launch[@]}" renumberMesh -constant -overwrite "${options[@]}" > "${CASE_DIR}/logFiles/20_renumberMesh.log" 2>&1
"${launch[@]}" potentialFoam -initialiseUBCs "${options[@]}" > "${CASE_DIR}/logFiles/30_potentialFoam.log" 2>&1
"${launch[@]}" applyBoundaryLayer -ybl 0.0450244 "${options[@]}" > "${CASE_DIR}/logFiles/40_applyBoundaryLayer.log" 2>&1
mpiexec -n "${NODES}" -ppn 1 --cpu-bind none /usr/bin/bash "${SCRIPT_DIR}/observe-placement.sh" "${CASE_DIR}/logFiles/50_simpleFoam.log" "${CASE_DIR}/logFiles/placement" &
observer=$!
"${launch[@]}" simpleFoam "${options[@]}" > "${CASE_DIR}/logFiles/50_simpleFoam.log" 2>&1
kill "${observer}" 2>/dev/null || true
wait "${observer}" || true

cp -a postProcessing "${CASE_DIR}/"
mpiexec -n "${NODES}" -ppn 1 /usr/bin/bash -c 'cd "$1" && find . -path "./processor*/40/uniform/profiling" -print0 | tar --null -T - -cf - | tar -xf - -C "$2"' collect "${local_case}" "${CASE_DIR}"
find "${CASE_DIR}" -path "*/processor*/40/uniform/profiling" | wc -l
cat "${CASE_DIR}"/logFiles/placement/placement-*.txt | awk '$1 != "local_rank" {n++; if ($3 == $1) pinned++; share[n] = $6} END {asort(share); printf "observed %d ranks: %d pinned to their core, median share of pages on the home NUMA domain %.3f\n", n, pinned, share[int((n + 1) / 2)]}'
grep 'Average wall-clock time per time step' "${CASE_DIR}/logFiles/50_simpleFoam.log"
