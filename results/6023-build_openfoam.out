#!/bin/bash
#SBATCH -J "OF_debug"
#SBATCH -w g4
#SBATCH --cpus-per-task=64
#SBATCH -o /home/apacsc14/ni/hpc/results/%x-%j.out
# SBATCH -t 01:00:00

# set -e は一旦外して、どこで止まるか見るのも手です
# set -e 

cat $0

echo "=== Job Started: $(date) ==="
echo "Node: $(hostname)"
echo "Current Directory: $PWD"

export WORKDIR=/home/apacsc14/ni/hpc
cd $WORKDIR/programs || { echo "Directory not found"; exit 1; }

echo "--- wget openfoam ---"
export openfoam_ver=v2412
# wget https://dl.openfoam.com/source/${openfoam_ver}/OpenFOAM-${openfoam_ver}.tgz & \
# wget https://dl.openfoam.com/source/${openfoam_ver}/ThirdParty-${openfoam_ver}.tgz
# tar xfp OpenFOAM-${openfoam_ver}.tgz & \
# tar xfp ThirdParty-${openfoam_ver}.tgz

echo "--- Loading HPC-X ---"
HPCX_INIT=/scratch/public/hpcx/hpcx-v2.24-gcc-doca_ofed-redhat9-cuda12-x86_64/hpcx-init.sh
if [ -f "$HPCX_INIT" ]; then
    source "$HPCX_INIT" && hpcx_load
    echo "HPC-X loaded. mpicc path: $(which mpicc)"
else
    echo "ERROR: HPC-X init script not found at $HPCX_INIT"
    exit 1
fi

echo "--- Sourcing OpenFOAM bashrc ---"
OF_BASHRC=$PWD/OpenFOAM-v2412/etc/bashrc
if [ -f "$OF_BASHRC" ]; then
    source "$OF_BASHRC" WM_COMPILER=Gcc WM_MPLIB=SYSTEMOPENMPI WM_LABEL_SIZE=64 WM_PRECISION_OPTION=DP
    echo "OpenFOAM environment loaded."
else
    echo "ERROR: OpenFOAM bashrc not found at $OF_BASHRC"
    exit 1
fi

echo "--- Starting Allwmake ---"
cd $WM_PROJECT_DIR
./Allwmake -j 64 2>&1 | tee build.log

echo "=== Job Finished: $(date) ==="

