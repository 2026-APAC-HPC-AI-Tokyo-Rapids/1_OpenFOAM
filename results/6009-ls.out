#!/bin/sh
#SBATCH -J "test"
#SBATCH -o /home/apacsc14/ni/hpc/results/%x-%j.out
# SBATCH -e /home/apacsc14/ni/hpc/results/%x-%j.err
set -e

cat $0

# echo "----module avail----"
# module avail

echo "----lscpu----"
lscpu

echo "----nvidia-smi----"
nvidia-smi

echo "----lspci----"
lspci

echo "----cat /etc/os-release----"
cat /etc/os-release

echo "----uname -a----"
uname -a

echo "----hostnamectl----"
hostnamectl

echo "----numactl --hardware----"
numactl --hardware

echo "----ibstat----"
ibstat
