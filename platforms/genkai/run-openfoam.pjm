#!/usr/bin/env bash
#PJM -L elapse=01:00:00

set -euo pipefail

: "${PJM_JOBID:?PJM job ID is required}"
: "${OPENFOAM_NODES:?protocol node count is required}"
: "${OPENFOAM_MPI_PROCS:?protocol rank count is required}"
: "${OPENFOAM_TRANSPORT_POLICY:?protocol transport policy is required}"
: "${PROVISION_DIR:?provision directory is required}"

module purge
module load intel/2025.1.3 impi

# ログイン環境では、cppだけを含みcc1を実行できない利用者導入のGCCがPATHの
# 先頭に置かれる場合がある。coded function objectには玄界のOSが提供する
# 一式そろったGCC補助ツールを使い、OpenFOAM本体には読み込んだIntel
# コンパイラとMPIを引き続き使う。
user_local_bin="${HOME}/.local/bin:"
export PATH="${PATH//${user_local_bin}/}"

set +eu
readarray -t build_environment < <("${PROVISION_DIR}/experiment-metrics/.venv/bin/python" -c 'import json, sys; flags = json.load(open(sys.argv[1], encoding="utf-8"))["compile_flags"]; values = {key: [item.removeprefix(key + "=") for item in flags if item.startswith(key + "=")] for key in ("WM_COMPILE_OPTION", "WM_OPTIONS")}; all(len(value) == 1 for value in values.values()) or sys.exit(1); print(values["WM_COMPILE_OPTION"][0]); print(values["WM_OPTIONS"][0])' "${RUN_DIR}/control/build-sidecar.json")
[[ "${#build_environment[@]}" -eq 2 && "${build_environment[0]}" =~ ^[A-Za-z0-9]+$ && "${build_environment[1]}" =~ ^[A-Za-z0-9]+$ ]]
source "${PROVISION_DIR}/OpenFOAM/etc/bashrc" WM_COMPILER=Icx WM_MPLIB=INTELMPI WM_LABEL_SIZE=32 WM_PRECISION_OPTION=DP WM_COMPILE_OPTION="${build_environment[0]}"
set -eu
test "${WM_OPTIONS}" = "${build_environment[1]}"

export I_MPI_FABRICS="${OPENFOAM_TRANSPORT_POLICY}"
export WORKLOAD_MESH_ARCHIVE="/home/pj26000080/share/openfoam-workload/polyMesh_65M.tar.gz"
unset I_MPI_DEBUG I_MPI_PIN_DOMAIN I_MPI_PIN_ORDER I_MPI_PIN_PROCESSOR_LIST
unset I_MPI_ADJUST_ALLREDUCE I_MPI_TUNING_MODE I_MPI_TUNING_AUTO_SYNC
unset I_MPI_TUNING_AUTO_ITER_NUM I_MPI_TUNING_BIN I_MPI_TUNING_BIN_DUMP
ranks_per_node=$(( OPENFOAM_MPI_PROCS / OPENFOAM_NODES ))
if (( ranks_per_node == 112 )); then
  export I_MPI_PIN_PROCESSOR_LIST="0-13,15-28,30-43,45-58,60-73,75-88,90-103,105-118"
fi

mpirun_path=$(command -v mpirun)
exec "${PROVISION_DIR}/scripts/run-openfoam.sh" --job-id "${PJM_JOBID}" --case-cache-root "/home/pj26000080/share/openfoam-case-cache" --paraview-collector "${PROVISION_DIR}/scripts/archive-paraview-case.sh" --large-output-dir "${RUN_DIR}/large-output" --global-rank-env PMI_RANK --local-rank-env MPI_LOCALRANKID --local-size-env MPI_LOCALNRANKS --solver-launch-arg "${mpirun_path}" --solver-launch-arg -np --solver-launch-arg "${OPENFOAM_MPI_PROCS}" --solver-launch-arg -ppn --solver-launch-arg "${ranks_per_node}" --solver-launch-arg -genv --solver-launch-arg PATH --solver-launch-arg "${PATH}" --node-launch-arg "${mpirun_path}" --node-launch-arg -np --node-launch-arg "${OPENFOAM_NODES}" --node-launch-arg -ppn --node-launch-arg 1 --node-launch-arg -genv --node-launch-arg PATH --node-launch-arg "${PATH}"
