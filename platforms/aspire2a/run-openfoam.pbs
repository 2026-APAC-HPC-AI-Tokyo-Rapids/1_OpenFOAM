#!/usr/bin/env bash
#PBS -l walltime=01:00:00

set -euo pipefail

: "${PBS_JOBID:?PBS job ID is required}"
: "${PBS_NODEFILE:?PBS node file is required}"
: "${TMPDIR:?PBS node-local temporary directory is required}"
: "${OPENFOAM_NODES:?protocol node count is required}"
: "${OPENFOAM_MPI_PROCS:?protocol rank count is required}"
: "${OPENFOAM_RUN_PURPOSE:?run purpose is required}"
: "${PROVISION_DIR:?provision directory is required}"

source "${PROVISION_DIR}/platforms/aspire2a/toolchain.conf"
source "${PROVISION_DIR}/platforms/aspire2a/toolchain.sh"
aspire2a_load_toolchain "${aspire2a_toolchain}"
test "${OMP_NUM_THREADS:?PBS OpenMP thread count is required}" = 1
if [[ "${OPENFOAM_RUN_PURPOSE}" == profile ]]; then
  : "${OPENFOAM_PROFILE_TOOL:?profile tool is required}"
  case "${OPENFOAM_PROFILE_TOOL}" in
    uprof) export AMDUPROF_ROOT=/scratch/users/industry/ai-hpc/apacsc14/openfoam/aspire2a/tools/amduprof-5.3.521 ;;
    craypat) module use /opt/cray/pe/modulefiles; module load perftools-base/22.04.0; module load perftools-preload ;;
    mpi_timing) ;;
    *) printf 'ASPIRE-2Aで未対応のprofile toolです: %s\n' "${OPENFOAM_PROFILE_TOOL}" >&2; exit 2 ;;
  esac
fi

mpiexec_path=$(command -v mpiexec)
runtime_root="${TMPDIR}/openfoam-runtime"
"${mpiexec_path}" -n "${OPENFOAM_NODES}" -ppn 1 /usr/bin/bash "${PROVISION_DIR}/platforms/aspire2a/stage-openfoam-runtime.sh" "${PROVISION_DIR}/runtime.tar.zst" "${PROVISION_DIR}/control/build-sidecar.json" "${PROVISION_DIR}/compute-tools.tar.zst" "${PROVISION_DIR}/control/compute-tools.json" "${runtime_root}"

set +eu
source "${runtime_root}/OpenFOAM/etc/bashrc" WM_COMPILER="${aspire2a_wm_compiler}" WM_MPLIB="${aspire2a_wm_mplib}" WM_LABEL_SIZE=32 WM_PRECISION_OPTION=DP WM_COMPILE_OPTION=Opt
set -eu

export WORKLOAD_MESH_ARCHIVE="/scratch/users/industry/ai-hpc/${USER}/openfoam/aspire2a/workload/polyMesh_65M.tar.gz"
imb_bin="${FOAM_APPBIN}/IMB-MPI1"
ldd "${imb_bin}" > "${RUN_DIR}/logs/imb-mpi1-ldd.log"
cat "${RUN_DIR}/logs/imb-mpi1-ldd.log"
grep -Fq "${aspire2a_mpi_library_root}/libmpi_" "${RUN_DIR}/logs/imb-mpi1-ldd.log"
for ucx_library in libucp.so libucs.so libuct.so; do grep -Fq "${ucx_library}" "${RUN_DIR}/logs/imb-mpi1-ldd.log"; done
if grep -q 'libfabric[.]so' "${RUN_DIR}/logs/imb-mpi1-ldd.log"; then printf '%s\n' 'UCX版IMB-MPI1がlibfabricにlinkしています' >&2; exit 1; fi
if grep -q '/oneapi/' "${RUN_DIR}/logs/imb-mpi1-ldd.log"; then printf '%s\n' 'ASPIRE-2A用IMB-MPI1がIntel oneAPIにlinkしています' >&2; exit 1; fi
ldd "$(command -v simpleFoam)" > "${RUN_DIR}/logs/aocl-runtime-link.log"
cat "${RUN_DIR}/logs/aocl-runtime-link.log"
grep -Fq "${aspire2a_aocl_libm}" "${RUN_DIR}/logs/aocl-runtime-link.log"
if grep -Fq "${aspire2a_aocl_libmem}" "${RUN_DIR}/logs/aocl-runtime-link.log"; then printf '%s\n' 'UCX実行へAOCL LibMemがpreloadされています' >&2; exit 1; fi
grep -Fq "${aspire2a_mpi_library_root}/libmpi_" "${RUN_DIR}/logs/aocl-runtime-link.log"
for ucx_library in libucp.so libucs.so libuct.so; do grep -Fq "${ucx_library}" "${RUN_DIR}/logs/aocl-runtime-link.log"; done
if grep -q 'libfabric[.]so' "${RUN_DIR}/logs/aocl-runtime-link.log"; then printf '%s\n' 'UCX版simpleFoamがlibfabricにlinkしています' >&2; exit 1; fi
if grep -q '/oneapi/' "${RUN_DIR}/logs/aocl-runtime-link.log"; then printf '%s\n' 'ASPIRE-2A用simpleFoamがIntel oneAPIにlinkしています' >&2; exit 1; fi
ranks_per_node=$(( OPENFOAM_MPI_PROCS / OPENFOAM_NODES ))
# Ranks sharing one L3 (ASPIRE-2A has 16 L3 groups per node with 8 cores each).
# 8 fills every physical core; a smaller fixed value reserves cores per L3.
ranks_per_l3=8
if (( ranks_per_node % 16 != 0 )); then printf '%s\n' 'ASPIRE-2Aのrank数がL3グループ数に整合しません' >&2; exit 64; fi
if (( ranks_per_l3 < 1 || ranks_per_l3 > 8 )); then printf '%s\n' 'ASPIRE-2Aのranks-per-L3が範囲外です' >&2; exit 64; fi
solver_iterations=${OPENFOAM_DIAGNOSTIC_ITERATIONS:-${OPENFOAM_ITERATIONS}}
rank_affinity="${PROVISION_DIR}/platforms/aspire2a/libmpi-rank-affinity.so"
ldd "${rank_affinity}" > "${RUN_DIR}/logs/mpi-rank-affinity-ldd.log"
grep -Eq '/opt/cray/pe/(mpich/.*/lib|lib64)/libmpi' "${RUN_DIR}/logs/mpi-rank-affinity-ldd.log"
if grep -q '/oneapi/' "${RUN_DIR}/logs/mpi-rank-affinity-ldd.log"; then printf '%s\n' 'ASPIRE-2A用MPI affinity interposerがIntel oneAPIにlinkしています' >&2; exit 1; fi
case_archive_root="/scratch/users/industry/ai-hpc/${USER}/openfoam/aspire2a/case-archives"
decomposition_options=(--multi-level-ranks-per-node 128)
if (( OPENFOAM_MPI_PROCS == 448 || OPENFOAM_MPI_PROCS == 1024 )); then
  case $(cat "${PROVISION_DIR}/platforms/aspire2a/decomposition-4n.txt") in
    hierarchical) decomposition_options=(--case-default-hierarchical) ;;
    multilevel) decomposition_options=(--multi-level-domains 4,2,4,16) ;;
    *) echo '未対応の4ノード分割条件です' >&2; exit 64 ;;
  esac
fi
identity_output=$("${PROVISION_DIR}/scripts/prepare-openfoam-case.sh" "${PROVISION_DIR}/benchmark/occDrivAerStaticMesh" - "$(command -v decomposePar)" "$(command -v checkMesh)" "${WORKLOAD_MESH_ARCHIVE}" "${PROVISION_DIR}/benchmark/workload.json" "${RUN_DIR}/control/build-sidecar.json" "${OPENFOAM_MPI_PROCS}" "${case_archive_root}" --identity-only "${decomposition_options[@]}")
cache_identity=$(sed -n 's/^cache_identity=//p' <<< "${identity_output}")
case_archive_dir="${case_archive_root}/${cache_identity}"
case_dir="${TMPDIR}/openfoam-case/occDrivAerStaticMesh"
"${mpiexec_path}" -n "${OPENFOAM_NODES}" -ppn 1 /usr/bin/bash "${PROVISION_DIR}/platforms/aspire2a/stage-openfoam-case.sh" "${case_archive_dir}" "${cache_identity}" "${solver_iterations}" "${case_dir}" "${runtime_root}"
rank_context_root="${TMPDIR}/openfoam-run"
"${mpiexec_path}" -n "${OPENFOAM_NODES}" -ppn 1 /usr/bin/bash "${PROVISION_DIR}/platforms/aspire2a/stage-rank-context.sh" "${RUN_MANIFEST}" "${rank_context_root}"
host_roots="((\".*\" \"${TMPDIR}/openfoam-case\"))"
distributed_root_args=()
if (( OPENFOAM_NODES > 1 )); then
  io_ranks="("
  for (( node = 0; node < OPENFOAM_NODES; node++ )); do io_ranks+="$(( node * ranks_per_node )) "; done
  io_ranks="${io_ranks% })"
  distributed_root_args=(--openfoam-arg -hostRoots --openfoam-arg "${host_roots}" --openfoam-arg -ioRanks --openfoam-arg "${io_ranks}")
fi
exec "${PROVISION_DIR}/scripts/run-openfoam.sh" --job-id "${PBS_JOBID}" --runtime-root "${runtime_root}" --compute-tools-root "${runtime_root}" --case-dir "${case_dir}" --prepared-case-manifest "${case_archive_dir}/case-manifest.json" --rank-manifest "${rank_context_root}/control/run-manifest.json" --rank-placement-root "${rank_context_root}/source/placement" --placement-collector "${runtime_root}/platforms/aspire2a/collect-rank-placement.sh" --bind-rank-placement --imb-bin "${imb_bin}" --global-rank-env PMI_RANK --local-rank-env PMI_LOCAL_RANK --local-size-env PMI_LOCAL_SIZE "${distributed_root_args[@]}" --solver-launch-arg "${mpiexec_path}" --solver-launch-arg --env --solver-launch-arg "LD_PRELOAD=${rank_affinity}" --solver-launch-arg --env --solver-launch-arg "ASPIRE2A_RANKS_PER_L3=${ranks_per_l3}" --solver-launch-arg -n --solver-launch-arg "${OPENFOAM_MPI_PROCS}" --solver-launch-arg -ppn --solver-launch-arg "${ranks_per_node}" --solver-launch-arg --cpu-bind --solver-launch-arg depth --solver-launch-arg -d --solver-launch-arg 1 --node-launch-arg "${mpiexec_path}" --node-launch-arg -n --node-launch-arg "${OPENFOAM_NODES}" --node-launch-arg -ppn --node-launch-arg 1
