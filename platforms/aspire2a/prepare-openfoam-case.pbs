#!/usr/bin/env bash
#PBS -l walltime=00:30:00

set -euo pipefail

: "${TMPDIR:?PBS node-local temporary directory is required}"
: "${PROVISION_DIR:?provision directory is required}"
: "${PREPARE_SUBDOMAINS:?requested decomposition size is required}"
: "${PREPARE_CACHE_ROOT:?case cache root is required}"
: "${WORKLOAD_MESH_ARCHIVE:?mesh archive is required}"
[[ "${PREPARE_SUBDOMAINS}" =~ ^[1-9][0-9]*$ ]]

source "${PROVISION_DIR}/platforms/aspire2a/toolchain.conf"
source "${PROVISION_DIR}/platforms/aspire2a/toolchain.sh"
aspire2a_load_toolchain "${aspire2a_toolchain}"

runtime_root="${TMPDIR}/openfoam-runtime"
"${PROVISION_DIR}/platforms/aspire2a/stage-openfoam-runtime.sh" "${PROVISION_DIR}/runtime.tar.zst" "${PROVISION_DIR}/control/build-sidecar.json" "${runtime_root}"

set +eu
source "${runtime_root}/OpenFOAM/etc/bashrc" WM_COMPILER="${aspire2a_wm_compiler}" WM_MPLIB="${aspire2a_wm_mplib}" WM_LABEL_SIZE=32 WM_PRECISION_OPTION=DP WM_COMPILE_OPTION=Opt
set -eu

decompose_par=$(command -v decomposePar)
check_mesh=$(command -v checkMesh)
decomposition_options=(--multi-level-ranks-per-node 128)
if (( PREPARE_SUBDOMAINS == 512 )); then
  case $(cat "${PROVISION_DIR}/platforms/aspire2a/decomposition-4n.txt") in
    hierarchical) decomposition_options=(--hierarchical-n "$(cat "${PROVISION_DIR}/platforms/aspire2a/hierarchical-n.txt")" --hierarchical-order "$(cat "${PROVISION_DIR}/platforms/aspire2a/hierarchical-order.txt")") ;;
    multilevel) decomposition_options=(--multi-level-domains 4,2,4,16) ;;
    scotch) decomposition_options=() ;;
    *) echo '未対応の4ノード分割条件です' >&2; exit 64 ;;
  esac
fi
identity_output=$("${PROVISION_DIR}/scripts/prepare-openfoam-case.sh" "${PROVISION_DIR}/benchmark/occDrivAerStaticMesh" - "${decompose_par}" "${check_mesh}" "${WORKLOAD_MESH_ARCHIVE}" "${PROVISION_DIR}/benchmark/workload.json" "${PROVISION_DIR}/control/build-sidecar.json" "${PREPARE_SUBDOMAINS}" "${PREPARE_CACHE_ROOT}" --identity-only "${decomposition_options[@]}")
cache_identity=$(sed -n 's/^cache_identity=//p' <<< "${identity_output}")
archive_dir="${PREPARE_CACHE_ROOT}/${cache_identity}"

if "${PROVISION_DIR}/platforms/aspire2a/archive-openfoam-case.sh" verify "${archive_dir}" "${cache_identity}" 2>/dev/null; then
  printf 'cache_hit=true\ncache_dir=%s\n' "${archive_dir}"
  exit 0
fi

expanded_root="${TMPDIR}/openfoam-case-expanded"
prepare_output=$("${PROVISION_DIR}/scripts/prepare-openfoam-case.sh" "${PROVISION_DIR}/benchmark/occDrivAerStaticMesh" - "${decompose_par}" "${check_mesh}" "${WORKLOAD_MESH_ARCHIVE}" "${PROVISION_DIR}/benchmark/workload.json" "${PROVISION_DIR}/control/build-sidecar.json" "${PREPARE_SUBDOMAINS}" "${expanded_root}" "${decomposition_options[@]}")
expanded_cache_dir=$(sed -n 's/^cache_dir=//p' <<< "${prepare_output}")
"${PROVISION_DIR}/platforms/aspire2a/archive-openfoam-case.sh" create "${expanded_cache_dir}" "${archive_dir}" "${cache_identity}"
