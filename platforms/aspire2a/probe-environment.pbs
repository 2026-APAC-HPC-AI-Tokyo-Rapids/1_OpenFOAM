#!/usr/bin/env bash
#PBS -P 59000014
#PBS -q normal
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=1gb
#PBS -l walltime=00:05:00
#PBS -N openfoam_probe
#PBS -j oe

set -euo pipefail

: "${PBS_JOBID:?PBS job ID is required}"
: "${PBS_NODEFILE:?PBS node file is required}"
: "${PBS_O_WORKDIR:?PBS submission directory is required}"

cd "${PBS_O_WORKDIR}"
source "${PBS_O_WORKDIR}/platforms/aspire2a/toolchain.sh"

printf 'job_id=%s\n' "${PBS_JOBID}"
printf 'execution_host=%s\n' "$(hostname -f)"
printf 'working_directory=%s\n' "${PWD}"
printf 'nodefile=%s\n' "${PBS_NODEFILE}"
printf '%s\n' '--- nodefile ---'
cat "${PBS_NODEFILE}"
printf '%s\n' '--- cpu ---'
lscpu
printf '%s\n' '--- memory ---'
free -h
printf '%s\n' '--- filesystems ---'
df -h "${HOME}" /scratch "${TMPDIR:-/tmp}"
printf '%s\n' '--- mounts ---'
findmnt -T "${HOME}"
findmnt -T /scratch
findmnt -T "${TMPDIR:-/tmp}"
printf '%s\n' '--- build tools ---'
for command_name in jq tar uv zstd
do
  command -v "${command_name}"
done
uv --version
for aspire2a_toolchain in gnu aocc
do
  printf '%s\n' "--- toolchain ${aspire2a_toolchain} ---"
  aspire2a_load_toolchain "${aspire2a_toolchain}"
  module -t list
  "${aspire2a_cc}" --version
  "${aspire2a_cxx}" --version
  "${aspire2a_cxx}" -craype-verbose 2>&1 || true
  "${aspire2a_mpi_launcher}" --version
  printf 'wm_compiler=%s\nwm_mplib=%s\naocl_module=%s\naocl_root=%s\n' "${aspire2a_wm_compiler}" "${aspire2a_wm_mplib}" "${aspire2a_aocl_module}" "${AOCL_ROOT}"
  "${aspire2a_mpi_launcher}" -n 1 bash -lc 'printf "rank_host=%s\n" "$(hostname -f)"; env | LC_ALL=C sort | grep -E "^(PBS|PMI|PALS|MPICH|FI_|CRAY|TMPDIR)" || true'
done
