#!/usr/bin/env bash
#PBS -l walltime=01:00:00

set -euo pipefail

: "${PBS_JOBID:?PBS job ID is required}"
: "${PBS_JOBFS:?PBS job-local filesystem is required}"
: "${OPENFOAM_NODES:?protocol node count is required}"
: "${OPENFOAM_MPI_PROCS:?protocol rank count is required}"
: "${PROVISION_DIR:?provision directory is required}"

module purge
module load gcc/13.2.0 openmpi/4.1.7

set +eu
readarray -t build_environment < <("${PROVISION_DIR}/experiment-metrics/.venv/bin/python" -c 'import json, sys; flags = json.load(open(sys.argv[1], encoding="utf-8"))["compile_flags"]; values = {key: [item.removeprefix(key + "=") for item in flags if item.startswith(key + "=")] for key in ("WM_COMPILE_OPTION", "WM_OPTIONS")}; all(len(value) == 1 for value in values.values()) or sys.exit(1); print(values["WM_COMPILE_OPTION"][0]); print(values["WM_OPTIONS"][0])' "${RUN_DIR}/control/build-sidecar.json")
[[ "${#build_environment[@]}" -eq 2 && "${build_environment[0]}" =~ ^[A-Za-z0-9]+$ && "${build_environment[1]}" =~ ^[A-Za-z0-9]+$ ]]
source "${PROVISION_DIR}/OpenFOAM/etc/bashrc" WM_COMPILER=Gcc WM_MPLIB=SYSTEMOPENMPI WM_LABEL_SIZE=64 WM_PRECISION_OPTION=DP WM_COMPILE_OPTION="${build_environment[0]}"
set -eu
test "${WM_OPTIONS}" = "${build_environment[1]}"

mpirun_path=$(command -v mpirun)
exec "${PROVISION_DIR}/scripts/run-openfoam.sh" --job-id "${PBS_JOBID}" --case-cache-root "/scratch/hb15/${USER}/openfoam/gadi/case-cache" --profile-root "/scratch/hb15/${USER}/openfoam/gadi/profile" --global-rank-env OMPI_COMM_WORLD_RANK --local-rank-env OMPI_COMM_WORLD_LOCAL_RANK --local-size-env OMPI_COMM_WORLD_LOCAL_SIZE --solver-launch-arg "${mpirun_path}" --solver-launch-arg -np --solver-launch-arg "${OPENFOAM_MPI_PROCS}" --solver-launch-arg --map-by --solver-launch-arg "ppr:$((OPENFOAM_MPI_PROCS / OPENFOAM_NODES)):node" --node-launch-arg "${mpirun_path}" --node-launch-arg -np --node-launch-arg "${OPENFOAM_NODES}" --node-launch-arg --map-by --node-launch-arg ppr:1:node
