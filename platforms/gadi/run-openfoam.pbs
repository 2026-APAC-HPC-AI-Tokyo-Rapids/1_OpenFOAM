#!/usr/bin/env bash
#PBS -l walltime=01:00:00

set -euo pipefail

: "${PBS_JOBID:?PBS job ID is required}"
: "${PBS_JOBFS:?PBS job-local filesystem is required}"
: "${PBS_NODEFILE:?PBS node file is required}"
: "${OPENFOAM_NODES:?protocol node count is required}"
: "${OPENFOAM_MPI_PROCS:?protocol rank count is required}"
: "${OPENFOAM_RUN_PURPOSE:?run purpose is required}"
: "${OPENFOAM_TRANSPORT_POLICY:?protocol transport policy is required}"
: "${PROVISION_DIR:?provision directory is required}"

module purge
module load intel-compiler-llvm/2025.1.1 intel-mpi/2021.15.0
if [[ "${OPENFOAM_RUN_PURPOSE}" == profile ]]; then module load intel-vtune/2025.3.0; fi

mpirun_path=$(command -v mpirun)
hosts=$(awk '!seen[$0]++' "${PBS_NODEFILE}" | paste -sd, -)
[[ "$(tr ',' '\n' <<< "${hosts}" | wc -l)" -eq "${OPENFOAM_NODES}" ]]
runtime_root="${PBS_JOBFS}/openfoam-runtime"
"${mpirun_path}" -hosts "${hosts}" -np "${OPENFOAM_NODES}" -ppn 1 "${PROVISION_DIR}/platforms/gadi/stage-openfoam-runtime.sh" "${PROVISION_DIR}/runtime.tar.zst" "${PROVISION_DIR}/control/build-sidecar.json" "${PROVISION_DIR}/compute-tools.tar.zst" "${PROVISION_DIR}/control/compute-tools.json" "${runtime_root}"

set +eu
readarray -t build_environment < <("${PROVISION_DIR}/experiment-metrics/.venv/bin/python" -c 'import json, sys; flags = json.load(open(sys.argv[1], encoding="utf-8"))["compile_flags"]; values = {key: [item.removeprefix(key + "=") for item in flags if item.startswith(key + "=")] for key in ("WM_COMPILE_OPTION", "WM_OPTIONS")}; all(len(value) == 1 for value in values.values()) or sys.exit(1); print(values["WM_COMPILE_OPTION"][0]); print(values["WM_OPTIONS"][0])' "${RUN_DIR}/control/build-sidecar.json")
[[ "${#build_environment[@]}" -eq 2 && "${build_environment[0]}" =~ ^[A-Za-z0-9]+$ && "${build_environment[1]}" =~ ^[A-Za-z0-9]+$ ]]
source "${runtime_root}/OpenFOAM/etc/bashrc" WM_COMPILER=Icx WM_MPLIB=INTELMPI WM_LABEL_SIZE=32 WM_PRECISION_OPTION=DP WM_COMPILE_OPTION="${build_environment[0]}"
set -eu
test "${WM_OPTIONS}" = "${build_environment[1]}"

export I_MPI_FABRICS="${OPENFOAM_TRANSPORT_POLICY}"
export WORKLOAD_MESH_ARCHIVE="/scratch/hb15/${USER}/openfoam/gadi/workload/polyMesh_65M.tar.gz"
ranks_per_node=$(( OPENFOAM_MPI_PROCS / OPENFOAM_NODES ))
case_archive_root="/scratch/hb15/${USER}/openfoam/gadi/case-archives"
identity_output=$("${PROVISION_DIR}/scripts/prepare-openfoam-case.sh" "${PROVISION_DIR}/benchmark/occDrivAerStaticMesh" - "$(command -v decomposePar)" "$(command -v checkMesh)" "${WORKLOAD_MESH_ARCHIVE}" "${PROVISION_DIR}/benchmark/workload.json" "${RUN_DIR}/control/build-sidecar.json" "${OPENFOAM_MPI_PROCS}" "${case_archive_root}" --identity-only)
cache_identity=$(sed -n 's/^cache_identity=//p' <<< "${identity_output}")
case_archive_dir="${case_archive_root}/${cache_identity}"
case_dir="${PBS_JOBFS}/openfoam-case/occDrivAerStaticMesh"
"${mpirun_path}" -hosts "${hosts}" -np "${OPENFOAM_NODES}" -ppn 1 "${PROVISION_DIR}/platforms/gadi/stage-openfoam-case.sh" "${case_archive_dir}" "${cache_identity}" "${OPENFOAM_ITERATIONS}" "${case_dir}" "${runtime_root}"
rank_context_root="${PBS_JOBFS}/openfoam-run"
"${mpirun_path}" -hosts "${hosts}" -np "${OPENFOAM_NODES}" -ppn 1 "${PROVISION_DIR}/platforms/gadi/stage-rank-context.sh" "${RUN_MANIFEST}" "${rank_context_root}"
host_roots="((\".*\" \"${PBS_JOBFS}/openfoam-case\"))"
distributed_root_args=()
if (( OPENFOAM_NODES > 1 )); then
  io_ranks="("
  for (( node = 0; node < OPENFOAM_NODES; node++ )); do io_ranks+="$(( node * ranks_per_node )) "; done
  io_ranks="${io_ranks% })"
  distributed_root_args=(--openfoam-arg -hostRoots --openfoam-arg "${host_roots}" --openfoam-arg -ioRanks --openfoam-arg "${io_ranks}")
fi
exec "${PROVISION_DIR}/scripts/run-openfoam.sh" --job-id "${PBS_JOBID}" --runtime-root "${runtime_root}" --compute-tools-root "${runtime_root}" --case-dir "${case_dir}" --prepared-case-manifest "${case_archive_dir}/case-manifest.json" --rank-manifest "${rank_context_root}/control/run-manifest.json" --rank-placement-root "${rank_context_root}/source/placement" --placement-collector "${runtime_root}/platforms/gadi/collect-rank-placement.sh" --paraview-collector "${runtime_root}/scripts/archive-paraview-case.sh" --profile-root "/scratch/hb15/${USER}/openfoam/gadi/profile" --global-rank-env PMI_RANK --local-rank-env MPI_LOCALRANKID --local-size-env MPI_LOCALNRANKS "${distributed_root_args[@]}" --solver-launch-arg "${mpirun_path}" --solver-launch-arg -hosts --solver-launch-arg "${hosts}" --solver-launch-arg -np --solver-launch-arg "${OPENFOAM_MPI_PROCS}" --solver-launch-arg -ppn --solver-launch-arg "${ranks_per_node}" --node-launch-arg "${mpirun_path}" --node-launch-arg -hosts --node-launch-arg "${hosts}" --node-launch-arg -np --node-launch-arg "${OPENFOAM_NODES}" --node-launch-arg -ppn --node-launch-arg 1
