#!/usr/bin/env bash
#PBS -l walltime=00:30:00

set -euo pipefail

: "${PROVISION_DIR:?provision directory is required}"
: "${PREPARE_SUBDOMAINS:?requested decomposition size is required}"
: "${PREPARE_CACHE_ROOT:?case cache root is required}"
: "${WORKLOAD_MESH_ARCHIVE:?mesh archive is required}"
[[ "${PREPARE_SUBDOMAINS}" =~ ^[1-9][0-9]*$ ]]

module purge
module load intel-compiler-llvm/2025.1.1 intel-mpi/2021.15.0

runtime_root="${PBS_JOBFS}/openfoam-runtime"
"${PROVISION_DIR}/platforms/gadi/stage-openfoam-runtime.sh" "${PROVISION_DIR}/runtime.tar.zst" "${PROVISION_DIR}/control/build-sidecar.json" "${runtime_root}"

set +eu
readarray -t build_environment < <("${PROVISION_DIR}/experiment-metrics/.venv/bin/python" -c 'import json, sys; flags = json.load(open(sys.argv[1], encoding="utf-8"))["compile_flags"]; values = {key: [item.removeprefix(key + "=") for item in flags if item.startswith(key + "=")] for key in ("WM_COMPILE_OPTION", "WM_OPTIONS")}; all(len(value) == 1 for value in values.values()) or sys.exit(1); print(values["WM_COMPILE_OPTION"][0]); print(values["WM_OPTIONS"][0])' "${PROVISION_DIR}/control/build-sidecar.json")
set +u
source "${runtime_root}/OpenFOAM/etc/bashrc" WM_COMPILER=Icx WM_MPLIB=INTELMPI WM_LABEL_SIZE=32 WM_PRECISION_OPTION=DP WM_COMPILE_OPTION="${build_environment[0]}"
set -eu
test "${WM_OPTIONS}" = "${build_environment[1]}"

DECOMPOSE_PAR=$(command -v decomposePar)
CHECK_MESH=$(command -v checkMesh)
identity_output=$("${PROVISION_DIR}/scripts/prepare-openfoam-case.sh" "${PROVISION_DIR}/benchmark/occDrivAerStaticMesh" - "${DECOMPOSE_PAR}" "${CHECK_MESH}" "${WORKLOAD_MESH_ARCHIVE}" "${PROVISION_DIR}/benchmark/workload.json" "${PROVISION_DIR}/control/build-sidecar.json" "${PREPARE_SUBDOMAINS}" "${PREPARE_CACHE_ROOT}" --identity-only)
cache_identity=$(sed -n 's/^cache_identity=//p' <<< "${identity_output}")
archive_dir="${PREPARE_CACHE_ROOT}/${cache_identity}"

if "${PROVISION_DIR}/platforms/gadi/archive-openfoam-case.sh" verify "${archive_dir}" "${cache_identity}" 2>/dev/null; then
  printf 'cache_hit=true\ncache_dir=%s\n' "${archive_dir}"
  exit 0
fi

expanded_root="${PBS_JOBFS}/openfoam-case-expanded"
prepare_output=$("${PROVISION_DIR}/scripts/prepare-openfoam-case.sh" "${PROVISION_DIR}/benchmark/occDrivAerStaticMesh" - "${DECOMPOSE_PAR}" "${CHECK_MESH}" "${WORKLOAD_MESH_ARCHIVE}" "${PROVISION_DIR}/benchmark/workload.json" "${PROVISION_DIR}/control/build-sidecar.json" "${PREPARE_SUBDOMAINS}" "${expanded_root}")
expanded_cache_dir=$(sed -n 's/^cache_dir=//p' <<< "${prepare_output}")
"${PROVISION_DIR}/platforms/gadi/archive-openfoam-case.sh" create "${expanded_cache_dir}" "${archive_dir}" "${cache_identity}"
