#!/usr/bin/env bash
#PBS -l walltime=02:00:00

set -euo pipefail

: "${PBS_JOBFS:?PBS job-local filesystem is required}"
: "${BUILD_ARCHIVE_DIR:?build archive directory is required}"
: "${BUILD_LOG_DIR:?build log directory is required}"
: "${BUILD_DEFINITION_REPO:?build definition checkout is required}"
: "${GITHUB_RUN_ATTEMPT:?GitHub run attempt is required}"
: "${GITHUB_RUN_ID:?GitHub run ID is required}"
: "${OPENFOAM_SOURCE_ARCHIVE:?OpenFOAM source archive is required}"
: "${OPENFOAM_SOURCE_ARCHIVE_SHA256:?OpenFOAM source archive digest is required}"
: "${OPENFOAM_SOURCE_OID:?OpenFOAM source commit is required}"
: "${THIRDPARTY_SOURCE_ARCHIVE:?ThirdParty source archive is required}"
: "${THIRDPARTY_SOURCE_ARCHIVE_SHA256:?ThirdParty source archive digest is required}"
: "${THIRDPARTY_SOURCE_OID:?ThirdParty source commit is required}"

[[ "${OPENFOAM_SOURCE_OID}" =~ ^[0-9a-f]{40,64}$ && "${THIRDPARTY_SOURCE_OID}" =~ ^[0-9a-f]{40,64}$ ]]
test "$(sha256sum "${OPENFOAM_SOURCE_ARCHIVE}" | awk '{print $1}')" = "${OPENFOAM_SOURCE_ARCHIVE_SHA256}"
test "$(sha256sum "${THIRDPARTY_SOURCE_ARCHIVE}" | awk '{print $1}')" = "${THIRDPARTY_SOURCE_ARCHIVE_SHA256}"

build_tree="${PBS_JOBFS}/openfoam-build"
openfoam_tree="${build_tree}/OpenFOAM"
thirdparty_tree="${build_tree}/ThirdParty"
publish_tmp="${BUILD_ARCHIVE_DIR}/.${GITHUB_RUN_ID}.tar.zst.${GITHUB_RUN_ATTEMPT}.tmp"
sidecar_tmp="${BUILD_ARCHIVE_DIR}/.${GITHUB_RUN_ID}.build-sidecar.json.${GITHUB_RUN_ATTEMPT}.tmp"
cleanup() {
  status=$?
  trap - EXIT INT TERM
  rm -f -- "${publish_tmp}" "${sidecar_tmp}" 2>/dev/null || true
  exit "${status}"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

install -d -m 0750 "${openfoam_tree}" "${thirdparty_tree}" "${BUILD_ARCHIVE_DIR}" "${BUILD_LOG_DIR}"
tar -xzf "${OPENFOAM_SOURCE_ARCHIVE}" -C "${openfoam_tree}" --strip-components=1
tar -xzf "${THIRDPARTY_SOURCE_ARCHIVE}" -C "${thirdparty_tree}" --strip-components=1
ln -s ../ThirdParty "${openfoam_tree}/ThirdParty"
install -d "${thirdparty_tree}/sources/scotch"
cp -a /apps/OpenFOAM/2512/ThirdParty-v2512/sources/scotch/scotch_6.1.0 "${thirdparty_tree}/sources/scotch/"

module purge
module load gcc/13.2.0 openmpi/4.1.7

set +eu
source "${openfoam_tree}/etc/bashrc" WM_COMPILER=Gcc WM_MPLIB=SYSTEMOPENMPI WM_LABEL_SIZE=64 WM_PRECISION_OPTION=DP WM_COMPILE_OPTION=Opt
set -eu
export FOAM_EXTRA_CXXFLAGS=
cd "${WM_PROJECT_DIR}"
"${BUILD_DEFINITION_REPO}/scripts/build-profiler.sh" "${BUILD_DEFINITION_REPO}/scripts/build-openfoam-task.sh" 104 "${BUILD_DEFINITION_REPO}/experiment-metrics/native" > "${BUILD_LOG_DIR}/allwmake.log" 2>&1 || {
  build_status=$?
  grep -Eai -m 200 '(^|[[:space:]])(fatal[[:space:]]+)?error([[:space:](]|:)|undefined reference|collect2:|make(\[[0-9]+\])?: \*\*\*|wmake error' "${BUILD_LOG_DIR}/allwmake.log" >&2 || true
  exit "${build_status}"
}

install -m 0755 "${BUILD_DEFINITION_REPO}/experiment-metrics/src/experiment_metrics/probes/capture_hardware.py" "${FOAM_APPBIN}/capture-hardware"
metrics_cli="${BUILD_DEFINITION_REPO}/experiment-metrics/.venv/bin/experiment-metrics"
build_state="${BUILD_LOG_DIR}/build-state.json"
"${metrics_cli}" capture-build-state --output "${build_state}" --build-tree "${build_tree}" --build-definition-repo "${BUILD_DEFINITION_REPO}" --openfoam-oid "${OPENFOAM_SOURCE_OID}" --openfoam-algorithm sha1 --thirdparty-oid "${THIRDPARTY_SOURCE_OID}" --thirdparty-algorithm sha1 --compiler-c "$(command -v gcc)" --compiler-cxx "$(command -v g++)" --mpi-launcher "$(command -v mpirun)" --precision DP --label-bits 64 --compile-flag BUILD_CONDITION=baseline --compile-flag "WM_OPTIONS=${WM_OPTIONS}" --compile-flag "WM_COMPILER=${WM_COMPILER}" --compile-flag "WM_COMPILE_OPTION=${WM_COMPILE_OPTION}" --compile-flag "WM_PRECISION_OPTION=${WM_PRECISION_OPTION}" --compile-flag "WM_LABEL_SIZE=${WM_LABEL_SIZE}" --compile-flag "FOAM_EXTRA_CXXFLAGS=${FOAM_EXTRA_CXXFLAGS}" --executable "icoFoam=${FOAM_APPBIN}/icoFoam" --executable "blockMesh=${FOAM_APPBIN}/blockMesh" --executable "decomposePar=${FOAM_APPBIN}/decomposePar" --executable "checkMesh=${FOAM_APPBIN}/checkMesh" --executable "mesh-facts=${FOAM_APPBIN}/mesh-facts" --executable "partition-audit=${FOAM_APPBIN}/partition-audit" --executable "capture-hardware=${FOAM_APPBIN}/capture-hardware"

tar -I zstd -cf "${publish_tmp}" -C "${build_tree}" .
"${metrics_cli}" finalize-build-sidecar --state "${build_state}" --archive "${publish_tmp}" --output "${sidecar_tmp}"
mv -- "${publish_tmp}" "${BUILD_ARCHIVE_DIR}/${GITHUB_RUN_ID}.tar.zst"
mv -- "${sidecar_tmp}" "${BUILD_ARCHIVE_DIR}/${GITHUB_RUN_ID}.build-sidecar.json"
trap - EXIT
