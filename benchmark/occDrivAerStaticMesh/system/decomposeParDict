FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include       "include/caseDefinition"

numberOfSubdomains  $nCores;

// note: kahip decomposition can not be used in conjunction with new wall
//       distance method "exactDistance" use hierachical instead
method              $decompositionMethod; //kahip; //hierarchical;

hierarchicalCoeffs
{
    n               $nHierarchical;
    delta           0.001;
    order           xyz;
}

// Map the subdomains onto the ASPIRE-2A node tree (scotch tree-leaf target).
// scotchDecomp adds the node level with weight 1 when nCores exceeds 128;
// below it come 2 sockets, 4 NUMA domains per socket and 16 cores per domain.
scotchCoeffs
{
    domains         (2 4 16);
    domainWeights   (0.125 0.0625 0.015625);
    // Quality-oriented variant of Scotch 6.1's default mapping strategy for
    // 512 parts: best of three bipartition trials, FM passes until no gain
    // (pass=-1), band width 3 and diffusion refinement, with imbalance 0.01
    // and the final exact balancing x{bal=0.01} kept.
    strategy        "m{vert=10240,rat=0.8,type=h,low=r{job=t,map=t,poli=S,bal=0.010000,sep=((m{vert=120,rat=0.8,low=h{pass=10}f{bal=0.010000,move=120,pass=-1,type=b},asc=b{width=3,bnd=f{bal=0.010000,move=120,pass=-1,type=b},org=f{bal=0.010000,move=120,pass=-1,type=b}}}|m{vert=120,rat=0.8,low=h{pass=10}f{bal=0.010000,move=120,pass=-1,type=b},asc=b{width=3,bnd=f{bal=0.010000,move=120,pass=-1,type=b},org=f{bal=0.010000,move=120,pass=-1,type=b}}})|m{vert=120,rat=0.8,low=h{pass=10}f{bal=0.010000,move=120,pass=-1,type=b},asc=b{width=3,bnd=f{bal=0.010000,move=120,pass=-1,type=b},org=f{bal=0.010000,move=120,pass=-1,type=b}}}f{bal=0.010000,move=80,pass=-1,type=b})},asc=b{width=3,bnd=d{pass=40,dif=1,rem=0}f{bal=0.010000,move=120,pass=-1},org=f{bal=0.010000,move=120,pass=-1}}}x{bal=0.010000}f{bal=0.010000,move=80}";
}

kahipCoeffs
{
    config          fast; // fast | eco | strong
    imbalance       0.01;
}

