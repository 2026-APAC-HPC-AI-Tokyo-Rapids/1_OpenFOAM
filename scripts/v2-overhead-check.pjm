#!/usr/bin/env bash
#PJM -L rscgrp=a-batch
#PJM -L node=1
#PJM -L elapse=00:50:00
#PJM --mpi proc=120

set -euo pipefail

: "${CHECK_DIR:?}"
: "${PJM_JOBID:?}"

case_dir="${CHECK_DIR}/case"
log_dir="${CHECK_DIR}/logs"
pstream_dir="${CHECK_DIR}/pstream"
decompose_dict=system/decomposeParDict.6
diagnostic_stage=entry
diagnostic_started_at="$(date --iso-8601=seconds)"
finish_diagnostic() {
  local status=$?
  trap - EXIT
  {
    printf 'schema_version=openfoam-v2-overhead-diagnostic/v1\n'
    printf 'pjm_job_id=%s\n' "${PJM_JOBID}"
    printf 'started_at=%s\n' "${diagnostic_started_at}"
    printf 'finished_at=%s\n' "$(date --iso-8601=seconds)"
    printf 'terminal_stage=%s\n' "${diagnostic_stage}"
    printf 'exit_code=%s\n' "${status}"
  } > "${CHECK_DIR}/diagnostic-status.txt"
  exit "${status}"
}
trap finish_diagnostic EXIT

module purge
module load intel/2025.1.3 impi
set +eu
source "${CHECK_DIR}/tree/OpenFOAM/etc/bashrc" \
  WM_COMPILER=Icx WM_MPLIB=INTELMPI WM_LABEL_SIZE=64 WM_PRECISION_OPTION=DP
set -eu

export I_MPI_FABRICS=shm
unset I_MPI_DEBUG I_MPI_PIN_DOMAIN I_MPI_PIN_ORDER I_MPI_PIN_PROCESSOR_LIST
unset I_MPI_ADJUST_ALLREDUCE I_MPI_TUNING_MODE I_MPI_TUNING_AUTO_SYNC
unset I_MPI_TUNING_AUTO_ITER_NUM I_MPI_TUNING_BIN_DUMP

mpiexec="$(command -v mpirun)"
block_mesh="$(command -v blockMesh)"
decompose_par="$(command -v decomposePar)"
solver="$(command -v icoFoam)"

cp -a "${CHECK_DIR}/task/cavity3D-64M" "${case_dir}"
cd "${case_dir}"
cat > "${decompose_dict}" <<'EOF'
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object decomposeParDict;
}

numberOfSubdomains 120;
method scotch;
EOF

diagnostic_stage=prepare_mesh
"${block_mesh}" -fileHandler uncollated >"${log_dir}/blockMesh.log" 2>&1
"${decompose_par}" -fileHandler uncollated \
  -decomposeParDict "${decompose_dict}" -force >"${log_dir}/decomposePar.log" 2>&1

# The solver does not reach a write interval in this five-step workload.  Seal
# the exact seven workload members plus the generated decomposition control so
# every repeated arm reads the same bytes, and reject any unexpected processor
# time directory after each trial.
sha256sum \
  0/U 0/p constant/transportProperties system/blockMeshDict \
  system/controlDict system/fvSchemes system/fvSolution \
  "${decompose_dict}" > "${CHECK_DIR}/workload.sha256"

run_arm() {
  local arm=$1
  local repetition=$2
  local trial="${arm}-${repetition}"
  local output="${log_dir}/${trial}.solver.log"
  local sink="${pstream_dir}/${trial}"
  local started ended
  diagnostic_stage="solver_${trial}"
  sha256sum --check "${CHECK_DIR}/workload.sha256" \
    >"${log_dir}/${trial}.workload-check.log"
  if [[ "${arm}" == off ]]; then
    unset OPENFOAM_METRICS_PSTREAM_DIR OPENFOAM_METRICS_RUN_ID
  else
    install -d "${sink}"
    export OPENFOAM_METRICS_PSTREAM_DIR="${sink}"
    printf -v OPENFOAM_METRICS_RUN_ID 'r-%032x' "${repetition}"
    export OPENFOAM_METRICS_RUN_ID
  fi
  started="$(date +%s%N)"
  "${mpiexec}" -np 120 -ppn 120 "${solver}" -parallel \
    -fileHandler uncollated -decomposeParDict "${decompose_dict}" \
    >"${output}" 2>&1
  ended="$(date +%s%N)"
  awk -v delta="$((ended - started))" 'BEGIN { printf "%.9f\n", delta / 1000000000 }' \
    >"${log_dir}/${trial}.wall-sec"
  sha256sum --check "${CHECK_DIR}/workload.sha256" \
    >"${log_dir}/${trial}.post-workload-check.log"
  if find processor* -mindepth 1 -maxdepth 1 -type d \
      ! -name 0 ! -name constant -print -quit | grep -q .; then
    printf '%s\n' "${trial} created an unexpected processor time directory" >&2
    return 1
  fi

  test -x "${CHECK_DIR}/parse_result.sh"
  "${CHECK_DIR}/parse_result.sh" "${output}" >"${log_dir}/${trial}.result"
  grep -qx 'STATUS: VALID' "${log_dir}/${trial}.result"
  grep -q '^RESULT:' "${log_dir}/${trial}.result"

  if [[ "${arm}" == on ]]; then
    local rank
    for rank in $(seq 0 119); do
      test -s "${sink}/rank-${rank}.jsonl"
    done
    test "$(find "${sink}" -maxdepth 1 -type f -name 'rank-*.jsonl' | wc -l)" -eq 120
  fi
}

# Alternate in execution order so both arms see the same allocation and any
# monotonic thermal/time drift is visible rather than hidden in one batch.
run_arm off 1
run_arm on 1
run_arm off 2
run_arm on 2

extract_markers() {
  sed -n \
    -e '/^nProcs[[:space:]]*:/p' \
    -e '/^Hosts[[:space:]]*:/,/^)/p' \
    -e '/^Time = /p' \
    -e '/Solving for p/p' \
    -e '/^End$/p' "$1"
}

diagnostic_stage=compare_outputs
for trial in off-1 on-1 off-2 on-2; do
  extract_markers "${log_dir}/${trial}.solver.log" >"${log_dir}/${trial}.markers"
  cmp -s "${log_dir}/off-1.markers" "${log_dir}/${trial}.markers"
done

trim_time() {
  sed -n 's/.* trim_time=\([^ ]*\)s .*/\1/p' "${log_dir}/$1.result"
}

off_1_trim="$(trim_time off-1)"
on_1_trim="$(trim_time on-1)"
off_2_trim="$(trim_time off-2)"
on_2_trim="$(trim_time on-2)"
for value in "${off_1_trim}" "${on_1_trim}" "${off_2_trim}" "${on_2_trim}"; do
  awk -v value="${value}" 'BEGIN { exit !(value + 0 > 0) }'
done
pair_1_ratio="$(awk -v off="${off_1_trim}" -v on="${on_1_trim}" \
  'BEGIN { printf "%.9f", on / off }')"
pair_2_ratio="$(awk -v off="${off_2_trim}" -v on="${on_2_trim}" \
  'BEGIN { printf "%.9f", on / off }')"
primary_ratio="$(awk \
  -v off1="${off_1_trim}" -v off2="${off_2_trim}" \
  -v on1="${on_1_trim}" -v on2="${on_2_trim}" \
  'BEGIN { printf "%.9f", (on1 + on2) / (off1 + off2) }')"

{
  printf 'schema_version=openfoam-v2-overhead-summary/v1\n'
  printf 'execution_order=off-1,on-1,off-2,on-2\n'
  for trial in off-1 on-1 off-2 on-2; do
    printf '%s_wall_sec=%s\n' "${trial}" "$(<"${log_dir}/${trial}.wall-sec")"
    printf '%s_trim_time_sec=%s\n' "${trial}" "$(trim_time "${trial}")"
    printf '%s_%s\n' "${trial}" "$(grep '^RESULT:' "${log_dir}/${trial}.result")"
  done
  printf 'pair_1_on_over_off_trim_ratio=%s\n' "${pair_1_ratio}"
  printf 'pair_2_on_over_off_trim_ratio=%s\n' "${pair_2_ratio}"
  printf 'primary_on_over_off_trim_ratio=%s\n' "${primary_ratio}"
  printf 'primary_overhead_limit_ratio=1.050000000\n'
  printf 'markers_equal=true\n'
  printf 'workload_identity_equal=true\n'
  printf 'pstream_complete_trials=2\n'
} >"${CHECK_DIR}/summary.txt"

diagnostic_stage=overhead_gate
awk -v ratio="${primary_ratio}" 'BEGIN { exit !(ratio <= 1.05) }'
diagnostic_stage=complete
