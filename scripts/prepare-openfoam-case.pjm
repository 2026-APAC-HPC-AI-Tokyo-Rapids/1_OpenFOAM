#!/usr/bin/env bash
#PJM -L elapse=00:30:00

set -euo pipefail

: "${PROVISION_DIR:?provision directory is required}"
: "${PREPARE_TARGET:?temporary materialization path is required}"
: "${PREPARE_SUBDOMAINS:?requested decomposition size is required}"
: "${PREPARE_DECOMPOSITION_PROFILE:?decomposition profile is required}"
[[ "${PREPARE_SUBDOMAINS}" =~ ^[1-9][0-9]*$ ]]

module purge
module load intel/2025.1.3 impi

readarray -t build_environment < <("${PROVISION_DIR}/experiment-metrics/.venv/bin/python" -c 'import json, sys; flags = json.load(open(sys.argv[1], encoding="utf-8"))["compile_flags"]; values = {key: [item.removeprefix(key + "=") for item in flags if item.startswith(key + "=")] for key in ("WM_COMPILE_OPTION", "WM_OPTIONS")}; all(len(value) == 1 for value in values.values()) or sys.exit(1); print(values["WM_COMPILE_OPTION"][0]); print(values["WM_OPTIONS"][0])' "${PROVISION_DIR}/control/build-sidecar.json")
set +eu
source "${PROVISION_DIR}/OpenFOAM/etc/bashrc" WM_COMPILER=Icx WM_MPLIB=INTELMPI WM_LABEL_SIZE=64 WM_PRECISION_OPTION=DP WM_COMPILE_OPTION="${build_environment[0]}"
set -eu
test "${WM_OPTIONS}" = "${build_environment[1]}"

BLOCK_MESH=$(command -v blockMesh)
DECOMPOSE_PAR=$(command -v decomposePar)
[[ "${BLOCK_MESH}" == /* && -x "${BLOCK_MESH}" ]]
[[ "${DECOMPOSE_PAR}" == /* && -x "${DECOMPOSE_PAR}" ]]

rm -f -- "${PREPARE_TARGET}"
trap 'rm -f -- "${PREPARE_TARGET}"' EXIT
[[ "${PREPARE_DECOMPOSITION_PROFILE}" == scotch ]]
"${PROVISION_DIR}/scripts/prepare-openfoam-case.sh" "${PROVISION_DIR}/task/cavity3D-64M" "${PREPARE_TARGET}" "${BLOCK_MESH}" "${DECOMPOSE_PAR}" "${PREPARE_SUBDOMAINS}"
[[ -L "${PREPARE_TARGET}" && -d "${PREPARE_TARGET}/processor$((PREPARE_SUBDOMAINS - 1))" ]]
