#!/usr/bin/env bash
#PJM -L elapse=00:30:00

set -euo pipefail

: "${PROVISION_DIR:?provision directory is required}"
: "${PREPARE_TARGET:?temporary materialization path is required}"
: "${PREPARE_SUBDOMAINS:?requested decomposition size is required}"
: "${PREPARE_DECOMPOSITION_PROFILE:?decomposition profile is required}"
[[ "${PREPARE_SUBDOMAINS}" =~ ^[1-9][0-9]*$ ]]

module purge
module load intel/2025.1.3 impi

set +eu
source "${PROVISION_DIR}/OpenFOAM/etc/bashrc" \
  WM_COMPILER=Icx WM_MPLIB=INTELMPI WM_LABEL_SIZE=64 WM_PRECISION_OPTION=DP
set -eu

BLOCK_MESH=$(command -v blockMesh)
DECOMPOSE_PAR=$(command -v decomposePar)
RENUMBER_MESH=$(command -v renumberMesh)
MPIEXEC=$(command -v mpirun)
[[ "${BLOCK_MESH}" == /* && -x "${BLOCK_MESH}" ]]
[[ "${DECOMPOSE_PAR}" == /* && -x "${DECOMPOSE_PAR}" ]]
[[ "${RENUMBER_MESH}" == /* && -x "${RENUMBER_MESH}" ]]
[[ "${MPIEXEC}" == /* && -x "${MPIEXEC}" ]]

rm -f -- "${PREPARE_TARGET}"
trap 'rm -f -- "${PREPARE_TARGET}"' EXIT
if [[ "${PREPARE_DECOMPOSITION_PROFILE}" == renumber-*-4n448 ]]; then
  [[ "${PREPARE_SUBDOMAINS}" == 448 ]]
  export I_MPI_PIN_PROCESSOR_LIST="0-13,15-28,30-43,45-58,60-73,75-88,90-103,105-118"
  "${PROVISION_DIR}/scripts/prepare-openfoam-renumbered-case.sh" \
    "${PROVISION_DIR}/task/cavity3D-64M" "${PREPARE_TARGET}" \
    "${PROVISION_DIR}/scripts/prepare-openfoam-case.sh" \
    "${BLOCK_MESH}" "${DECOMPOSE_PAR}" "${RENUMBER_MESH}" "${MPIEXEC}" \
    "${PREPARE_DECOMPOSITION_PROFILE}"
elif [[ "${PREPARE_DECOMPOSITION_PROFILE}" == scotch ]]; then
  "${PROVISION_DIR}/scripts/prepare-openfoam-case.sh" \
    "${PROVISION_DIR}/task/cavity3D-64M" "${PREPARE_TARGET}" \
    "${BLOCK_MESH}" "${DECOMPOSE_PAR}" "${PREPARE_SUBDOMAINS}"
elif [[ "${PREPARE_DECOMPOSITION_PROFILE}" == multilevel-node-numa-4n448 ]]; then
  [[ "${PREPARE_SUBDOMAINS}" == 448 ]]
  "${PROVISION_DIR}/scripts/prepare-openfoam-multilevel-448-case.sh" \
    "${PROVISION_DIR}/task/cavity3D-64M" "${PREPARE_TARGET}" \
    "${BLOCK_MESH}" "${DECOMPOSE_PAR}"
else
  [[ "${PREPARE_SUBDOMAINS}" == 480 ]]
  "${PROVISION_DIR}/scripts/prepare-openfoam-geometric-case.sh" \
    "${PROVISION_DIR}/task/cavity3D-64M" "${PREPARE_TARGET}" \
    "${BLOCK_MESH}" "${DECOMPOSE_PAR}" "${PREPARE_DECOMPOSITION_PROFILE}"
fi
[[ -L "${PREPARE_TARGET}" && \
   -d "${PREPARE_TARGET}/processor$((PREPARE_SUBDOMAINS - 1))" ]]
