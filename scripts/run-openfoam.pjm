#!/usr/bin/env bash
#PJM -L elapse=01:00:00

# Compute-side v2 executor.  It owns only local case data, source captures,
# logs, and atomic metric fragments. Producers send through the shared
# mode-0600 credential path; transport failure never changes solver status.
set -euo pipefail

: "${RUN_ID:?runner-generated v2 run ID is required}"
: "${RUN_MANIFEST:?runner-generated manifest path is required}"
: "${RUN_DIR:?runner-generated runtime path is required}"
: "${PROVISION_DIR:?provision directory is required}"
: "${PJM_JOBID:?}"
: "${OPENFOAM_NODES:?protocol node count is required}"
: "${OPENFOAM_RANKS:?protocol rank count is required}"
: "${OPENFOAM_RESOURCE_GROUP:?protocol resource group is required}"
: "${OPENFOAM_TRANSPORT_POLICY:?protocol transport policy is required}"

OPENFOAM_PROFILE_MODE=${OPENFOAM_PROFILE_MODE:-direct}
: "${OPENFOAM_VTUNE_RANK:=0}"
OPENFOAM_MPI_PROCS=${OPENFOAM_RANKS}
(( OPENFOAM_NODES > 0 && OPENFOAM_MPI_PROCS > 0 ))
(( OPENFOAM_MPI_PROCS % OPENFOAM_NODES == 0 ))
OPENFOAM_MPI_PPN=$(( OPENFOAM_MPI_PROCS / OPENFOAM_NODES ))
export OPENFOAM_MPI_PROCS OPENFOAM_MPI_PPN OPENFOAM_PROFILE_MODE
export OPENFOAM_VTUNE_RANK

CASE_DIR="${RUN_DIR}/work/cavity3D-64M"
CASE_INPUT_DIR="${RUN_DIR}/work/cavity3D-64M-input"
LOG_DIR="${RUN_DIR}/logs"
SOURCE_DIR="${RUN_DIR}/source"
RESULTS_DIR="${RUN_DIR}/results"
REGISTRY="${PROVISION_DIR}/experiment-metrics/registry/openfoam-v2.toml"
METRICS_CLI="${PROVISION_DIR}/experiment-metrics/.venv/bin/experiment-metrics"

# Fail before mesh/solver work if compute nodes cannot append raw metrics.
"${METRICS_CLI}" smoke-send --run "${RUN_ID}" --source compute
DECOMPOSE_PAR_DICT=system/decomposeParDict.6
SOLVER_LOG="${LOG_DIR}/solver.log"
SUPERVISOR_STATE="${RUN_DIR}/domain/supervisor-state.json"
PROFILE_RUN_ID="${RUN_ID}-${PJM_JOBID}"
OPENFOAM_PROFILE_DIR="${HOME}/openfoam-profile/${PROFILE_RUN_ID}"
OPENFOAM_VTUNE_ROOT="${HOME}/openfoam-vtune/${PROFILE_RUN_ID}"
OPENFOAM_VTUNE_RESULT_DIR="${OPENFOAM_VTUNE_ROOT}/rank-${OPENFOAM_VTUNE_RANK}"
export OPENFOAM_PROFILE_DIR PROFILE_RUN_ID
export OPENFOAM_VTUNE_RESULT_DIR
export OPENFOAM_METRICS_PSTREAM_DIR="${RUN_DIR}/domain/pstream"
export OPENFOAM_METRICS_RUN_ID="${RUN_ID}"

test "$(basename -- "${RUN_DIR}")" = "${RUN_ID}"
test -f "${RUN_MANIFEST}"
install -d -m 0755 "${CASE_DIR%/*}" "${LOG_DIR}" "${SOURCE_DIR}" "${RESULTS_DIR}" \
  "${OPENFOAM_METRICS_PSTREAM_DIR}" "${RUN_DIR}/domain"
"${METRICS_CLI}" supervisor-start \
  --manifest "${RUN_MANIFEST}" --state "${SUPERVISOR_STATE}"
finish_supervisor() {
  local original_status=$?
  local finish_status=0
  trap - EXIT
  set +e
  "${METRICS_CLI}" supervisor-finish \
    --manifest "${RUN_MANIFEST}" --state "${SUPERVISOR_STATE}" \
    --registry "${REGISTRY}" --exit-code "${original_status}"
  finish_status=$?
  if [[ "${original_status}" -eq 0 && "${finish_status}" -ne 0 ]]; then
    original_status=${finish_status}
  fi
  exit "${original_status}"
}
trap finish_supervisor EXIT
"${METRICS_CLI}" validate-bundle-runtime \
  --manifest "${RUN_MANIFEST}" \
  --bundle "${RUN_DIR}/control/instrumentation-bundle.json" \
  --registry "${REGISTRY}" \
  --artifact-root "${PROVISION_DIR}"

# One exact argv is given directly to StageRunner; stdout and stderr are a
# single durable record rather than a shell pipeline with ambiguous status.
stage() {
  local stage_name=$1
  local stdout_path=$2
  shift 2
  "${METRICS_CLI}" run-stage \
    --manifest "${RUN_MANIFEST}" \
    --runtime-dir "${RUN_DIR}" \
    --registry "${REGISTRY}" \
    --producer stage.runner \
    --stage "${stage_name}" \
    --cwd "${CASE_DIR}" \
    --stderr-mode stdout \
    --stdout-path "${stdout_path}" \
    -- "$@"
}

stage_at() {
  local stage_name=$1
  local stdout_path=$2
  local cwd=$3
  shift 3
  "${METRICS_CLI}" run-stage \
    --manifest "${RUN_MANIFEST}" \
    --runtime-dir "${RUN_DIR}" \
    --registry "${REGISTRY}" \
    --producer stage.runner \
    --stage "${stage_name}" \
    --cwd "${cwd}" \
    --stderr-mode stdout \
    --stdout-path "${stdout_path}" \
    -- "$@"
}

# This launch-effective value is captured at host-exec and per rank.
export I_MPI_FABRICS="${OPENFOAM_TRANSPORT_POLICY}"

module purge
module load intel/2025.1.3 impi

set +eu
source "${PROVISION_DIR}/OpenFOAM/etc/bashrc" \
  WM_COMPILER=Icx WM_MPLIB=INTELMPI WM_LABEL_SIZE=64 WM_PRECISION_OPTION=DP
set -eu

# capture-hardware is a tracked, dependency-free Python probe whose installed
# shebang is intentionally portable.  Genkai's system python3 is 3.6, while
# the probe and the metrics runtime require the provisioned Python.  Put that
# interpreter first for both the direct minimal capture and the MPI-launched
# profile capture; the executable identity remains the tracked probe itself.
PROBE_PYTHON_DIR="${PROVISION_DIR}/experiment-metrics/.venv/bin"
[[ -x "${PROBE_PYTHON_DIR}/python3" ]]
export PATH="${PROBE_PYTHON_DIR}:${PATH}"

unset I_MPI_DEBUG I_MPI_PIN_DOMAIN I_MPI_PIN_ORDER I_MPI_PIN_PROCESSOR_LIST
unset I_MPI_ADJUST_ALLREDUCE I_MPI_TUNING_MODE I_MPI_TUNING_AUTO_SYNC
unset I_MPI_TUNING_AUTO_ITER_NUM I_MPI_TUNING_BIN_DUMP

MPIEXEC=$(command -v mpirun)
BLOCK_MESH=$(command -v blockMesh)
DECOMPOSE_PAR=$(command -v decomposePar)
ICO_FOAM=$(command -v icoFoam)
CHECK_MESH=$(command -v checkMesh)
MESH_FACTS=$(command -v mesh-facts)
PARTITION_AUDIT=$(command -v partition-audit)
CAPTURE_HARDWARE=$(command -v capture-hardware)
for executable in "${MPIEXEC}" "${BLOCK_MESH}" "${DECOMPOSE_PAR}" \
  "${ICO_FOAM}" "${CHECK_MESH}" "${MESH_FACTS}" "${PARTITION_AUDIT}" \
  "${CAPTURE_HARDWARE}"
do
  [[ "${executable}" == /* && -x "${executable}" ]]
done

provision_args=(
  validate-provision
  --manifest "${RUN_MANIFEST}"
  --build-sidecar "${RUN_DIR}/control/build-sidecar.json"
  --provision-root "${PROVISION_DIR}"
  --output "${RUN_DIR}/control/build-provision-validation.json"
  --executable "icoFoam=${ICO_FOAM}"
  --executable "blockMesh=${BLOCK_MESH}"
  --executable "decomposePar=${DECOMPOSE_PAR}"
  --executable "checkMesh=${CHECK_MESH}"
  --executable "mesh-facts=${MESH_FACTS}"
  --executable "partition-audit=${PARTITION_AUDIT}"
  --executable "capture-hardware=${CAPTURE_HARDWARE}"
  --executable "mpirun=${MPIEXEC}"
)
if [[ "${OPENFOAM_PROFILE_MODE}" != direct ]]; then
  OPENFOAM_PERF_PATH=$(command -v perf)
  [[ "${OPENFOAM_PERF_PATH}" == /* && -x "${OPENFOAM_PERF_PATH}" ]]
  export OPENFOAM_PERF_PATH
  provision_args+=(--executable "perf=${OPENFOAM_PERF_PATH}")
fi
if [[ "${OPENFOAM_PROFILE_MODE}" == vtune-hotspots ]]; then
  [[ "${OPENFOAM_VTUNE_RANK}" =~ ^[0-9]+$ ]]
  (( OPENFOAM_VTUNE_RANK < OPENFOAM_MPI_PROCS ))
  command -v vtune >/dev/null
fi
"${METRICS_CLI}" "${provision_args[@]}"

test "${OPENFOAM_MPI_PROCS}" -eq 120
cp -a "${PROVISION_DIR}/task/cavity3D-64M" "${CASE_INPUT_DIR}"
install -d -m 0755 "${SOURCE_DIR}/mesh" "${SOURCE_DIR}/hardware"

# Seal the exact seven workload-defining files after setup and before the
# first OpenFOAM stage reads the case.
"${METRICS_CLI}" capture-workload \
  --manifest "${RUN_MANIFEST}" \
  --case-root "${CASE_INPUT_DIR}" \
  --output-root "${SOURCE_DIR}/workload"

"${METRICS_CLI}" supervisor-mark-pipeline \
  --state "${SUPERVISOR_STATE}" --mark start
stage_at case_prepare "${LOG_DIR}/case-prepare.log" "${CASE_DIR%/*}" \
  "${PROVISION_DIR}/scripts/prepare-openfoam-case.sh" \
  "${CASE_INPUT_DIR}" "${CASE_DIR}" "${BLOCK_MESH}" "${DECOMPOSE_PAR}" \
  --require-cache
cd "${CASE_DIR}"
install -m 0644 "${DECOMPOSE_PAR_DICT}" "${SOURCE_DIR}/mesh/decomposeParDict"
install -m 0644 logs/blockMesh.log "${LOG_DIR}/blockMesh.log"
install -m 0644 logs/decomposePar.log "${LOG_DIR}/decomposePar.log"
install -m 0644 "${HOME}/../share/openfoam-case-cache/$(sha256sum "${PROVISION_DIR}/scripts/prepare-openfoam-case.sh" | awk '{print $1}')/manifest.json" \
  "${SOURCE_DIR}/mesh/case-cache-manifest.json"

install -d -m 0700 "${HOME}/openfoam-profile" "${OPENFOAM_PROFILE_DIR}"
if [[ "${OPENFOAM_PROFILE_MODE}" == vtune-hotspots ]]; then
  install -d -m 0700 "${HOME}/openfoam-vtune" "${OPENFOAM_VTUNE_ROOT}"
fi
printf '%s\n' \
  "PJM_JOBID=${PJM_JOBID}" \
  "run_id=${RUN_ID}" \
  "launch_host=$(hostname)" \
  "mpi_procs=${OPENFOAM_MPI_PROCS}" \
  "profile_mode=${OPENFOAM_PROFILE_MODE}" \
  "created_at=$(date --iso-8601=seconds)" \
  > "${OPENFOAM_PROFILE_DIR}/run.txt"
cp system/decomposeParDict.6 system/controlDict "${OPENFOAM_PROFILE_DIR}/"
env | sort > "${OPENFOAM_PROFILE_DIR}/environment.txt"
{ printf 'host=%s\n' "$(hostname)"; lscpu; } > "${OPENFOAM_PROFILE_DIR}/nodes.txt"

install -d -m 0755 "${SOURCE_DIR}/env" "${SOURCE_DIR}/placement"
"${METRICS_CLI}" capture-host-exec \
  --manifest "${RUN_MANIFEST}" \
  --output "${SOURCE_DIR}/env/host-exec.snapshot"
set +e
if [[ "${OPENFOAM_PROFILE_MODE}" == perf-stat ]]; then
  install -d -m 0700 "${RUN_DIR}/profile/raw/perf"
  stage solver "${SOLVER_LOG}" \
    "${MPIEXEC}" -np "${OPENFOAM_MPI_PROCS}" -ppn "${OPENFOAM_MPI_PPN}" \
    "${PROVISION_DIR}/scripts/openfoam-rank-wrapper.py" \
    --run-id "${RUN_ID}" --expected-ranks "${OPENFOAM_MPI_PROCS}" \
    --output "${RUN_DIR}/profile/raw/perf/rank-{rank}.csv" \
    --perf "${OPENFOAM_PERF_PATH}" --solver "${ICO_FOAM}" -- \
    -parallel -fileHandler uncollated -decomposeParDict "${DECOMPOSE_PAR_DICT}"
elif [[ "${OPENFOAM_PROFILE_MODE}" == vtune-hotspots ]]; then
  # Every rank records its placement first. The selected rank then execs the
  # profiler, which launches icoFoam directly so VTune follows the solver
  # rather than the Python placement process.
  stage solver "${SOLVER_LOG}" \
    "${MPIEXEC}" -np "${OPENFOAM_MPI_PROCS}" -ppn "${OPENFOAM_MPI_PPN}" \
    "${PROVISION_DIR}/experiment-metrics/.venv/bin/python" \
    -m experiment_metrics.rank_wrapper \
    --manifest "${RUN_MANIFEST}" --expected-ranks "${OPENFOAM_MPI_PROCS}" \
    --expected-nodes "${OPENFOAM_NODES}" \
    --placement-root "${SOURCE_DIR}/placement" \
    --profile-rank "${OPENFOAM_VTUNE_RANK}" \
    --profile-wrapper "${PROVISION_DIR}/scripts/exec-profiler.sh" -- \
    "${ICO_FOAM}" -parallel \
    -fileHandler uncollated -decomposeParDict "${DECOMPOSE_PAR_DICT}"
else
  stage solver "${SOLVER_LOG}" \
    "${PROVISION_DIR}/scripts/exec-profiler.sh" \
    "${MPIEXEC}" -np "${OPENFOAM_MPI_PROCS}" -ppn "${OPENFOAM_MPI_PPN}" \
    "${PROVISION_DIR}/experiment-metrics/.venv/bin/python" \
    -m experiment_metrics.rank_wrapper \
    --manifest "${RUN_MANIFEST}" --expected-ranks "${OPENFOAM_MPI_PROCS}" \
    --expected-nodes "${OPENFOAM_NODES}" \
    --placement-root "${SOURCE_DIR}/placement" -- \
    "${ICO_FOAM}" -parallel \
    -fileHandler uncollated -decomposeParDict "${DECOMPOSE_PAR_DICT}"
fi
solver_status=$?
set -e
"${METRICS_CLI}" supervisor-mark-pipeline \
  --state "${SUPERVISOR_STATE}" --mark finish

cp "${SOLVER_LOG}" "${OPENFOAM_PROFILE_DIR}/"
if [[ "${solver_status}" -ne 0 ]]; then
  exit "${solver_status}"
fi

if [[ "${OPENFOAM_PROFILE_MODE}" == vtune-hotspots ]]; then
  "${PROVISION_DIR}/scripts/export-vtune-hotspots.sh"
fi

"${PROVISION_DIR}/task/parse_result.sh" "${SOLVER_LOG}" > "${RESULTS_DIR}/result.txt"
grep -qx 'STATUS: VALID' "${RESULTS_DIR}/result.txt"
grep -q '^RESULT:' "${RESULTS_DIR}/result.txt"

minimal_hardware_argv=(
  "${CAPTURE_HARDWARE}"
  --mode minimal
  --subject-kind regular_run
  --subject-id "${RUN_ID}"
  --manifest "${RUN_MANIFEST}"
  --output-root "${SOURCE_DIR}/hardware"
)
if (( OPENFOAM_NODES == 1 )); then
  minimal_hardware_argv+=(--node-ordinal 0)
else
  minimal_hardware_argv=(
    "${MPIEXEC}" -np "${OPENFOAM_NODES}" -ppn 1
    "${minimal_hardware_argv[@]}"
    --node-ordinal-from-env PMI_RANK
  )
fi
stage minimal_hardware_capture "${LOG_DIR}/minimal-hardware-capture.log" \
  "${minimal_hardware_argv[@]}"

if [[ "${OPENFOAM_PROFILE_MODE}" != direct ]]; then
  stage profile_hardware_capture "${LOG_DIR}/profile-hardware-capture.log" \
    "${MPIEXEC}" -np "${OPENFOAM_NODES}" -ppn 1 "${CAPTURE_HARDWARE}" \
    --mode profile-postrun --subject-kind regular_run --subject-id "${RUN_ID}" \
    --manifest "${RUN_MANIFEST}" --output-root "${RUN_DIR}/profile/raw/hardware" \
    --node-ordinal-from-env PMI_RANK
fi

# Network measurement is an independent post-solver stage.  Missing IMB,
# failed execution, or malformed output deliberately does not alter the solver
# success marker; network diagnostics remain a separate non-gating stage.
IMB_STDOUT="${SOURCE_DIR}/network/imb-mpi1/stdout.txt"
IMB_STDERR="${SOURCE_DIR}/network/imb-mpi1/stderr.txt"
IMB_ARGV="${SOURCE_DIR}/network/imb-mpi1/argv.json"
install -d -m 0755 "${IMB_STDOUT%/*}"
imb_bin=$(command -v IMB-MPI1 || true)
if [[ -n "${imb_bin}" ]]; then
  imb_argv=(
    "${MPIEXEC}" -np "${OPENFOAM_MPI_PROCS}" -ppn "${OPENFOAM_MPI_PPN}"
    "${imb_bin}" -npmin "${OPENFOAM_MPI_PROCS}" -msglog 0:22
    -iter 1000 -time 1 -iter_policy dynamic PingPong Sendrecv Allreduce
  )
  "${METRICS_CLI}" capture-argv --manifest "${RUN_MANIFEST}" \
    --output "${IMB_ARGV}" -- "${imb_argv[@]}"
  set +e
  "${METRICS_CLI}" run-stage \
    --manifest "${RUN_MANIFEST}" --runtime-dir "${RUN_DIR}" \
    --registry "${REGISTRY}" --producer stage.runner \
    --stage network_imb_mpi1 --cwd "${CASE_DIR}" \
    --stderr-mode separate --stdout-path "${IMB_STDOUT}" \
    --stderr-path "${IMB_STDERR}" --timeout-sec 600 -- "${imb_argv[@]}"
  imb_status=$?
  set -e
  if [[ "${imb_status}" -eq 0 ]]; then
    "${METRICS_CLI}" record-imb-mpi1 \
      --manifest "${RUN_MANIFEST}" \
      --runtime-dir "${RUN_DIR}" \
      --registry "${REGISTRY}" \
      --stdout "${IMB_STDOUT}" \
      --stderr "${IMB_STDERR}" \
      --argv-json "${IMB_ARGV}" \
      --protocol "${PROVISION_DIR}/experiment-metrics/registry/openfoam-v2-protocol.toml" \
      --source-member source/network/imb-mpi1/stdout.txt \
      ||
      printf '%s\n' 'IMB output was not a complete canonical capture' >&2
  else
    printf '%s\n' "IMB-MPI1 stage failed (${imb_status}); collection will be incomplete" >&2
  fi
else
  printf '%s\n' 'IMB-MPI1 is unavailable; collection will be incomplete' >&2
fi

if [[ "${OPENFOAM_PROFILE_MODE}" != direct ]]; then
  install -d -m 0700 "${RUN_DIR}/profile/raw"
  cp -a "${OPENFOAM_PROFILE_DIR}/." "${RUN_DIR}/profile/raw/"
fi

du -sh "${OPENFOAM_PROFILE_DIR}" > "${LOG_DIR}/profile-location.txt"
printf 'profile_dir=%s\n' "${OPENFOAM_PROFILE_DIR}" >> "${LOG_DIR}/profile-location.txt"
if [[ "${OPENFOAM_PROFILE_MODE}" == vtune-hotspots ]]; then
  vtune_result_dirs=()
  for candidate in "${OPENFOAM_VTUNE_RESULT_DIR}" "${OPENFOAM_VTUNE_RESULT_DIR}".*
  do
    [[ -d "${candidate}" ]] && vtune_result_dirs+=("${candidate}")
  done
  [[ "${#vtune_result_dirs[@]}" -eq 1 ]]
  du -sh "${OPENFOAM_VTUNE_ROOT}" >> "${LOG_DIR}/profile-location.txt"
  printf 'vtune_result_dir=%s\n' "${vtune_result_dirs[0]}" \
    >> "${LOG_DIR}/profile-location.txt"
fi

# Only solver validity controls the scheduler/job success marker.
touch "${RUN_DIR}/run-success"
