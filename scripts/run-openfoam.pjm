#!/usr/bin/env bash
#PJM -L rscgrp=a-batch
#PJM -L node=1
#PJM -L elapse=00:25:00
#PJM --mpi proc=120

# プロビジョニング済みの実行環境から、OpenFOAM の motorBike ケースを実行する。
set -euo pipefail

# ジョブの実行条件をスクリプト内で固定し、投入元の環境に依存しないようにする。
export OPENFOAM_MPI_PROCS=120
export OPENFOAM_PROFILE_LABEL=mpi-1node-120ranks-shm-default

# ジョブ実行に必要な環境変数が設定されていることを確認する。
: "${OPENFOAM_RUN_ROOT:?}"
: "${PROVISION_DIR:?}"
: "${PJM_JOBID:?}"


# ジョブ専用の作業ディレクトリとプロファイルの保存先を先に決めておく。
export RUN_DIR="$(mktemp -d "${OPENFOAM_RUN_ROOT}/job-${PJM_JOBID}.XXXXXXXXXX")"
export OPENFOAM_PROFILE_RUN_ID="${GITHUB_RUN_ID:-manual}-${PJM_JOBID}"
export OPENFOAM_PROFILE_DIR="${HOME}/openfoam-profile/${OPENFOAM_PROFILE_RUN_ID}"
export SOLVER_LOG="${PROVISION_DIR}/logs/solver-${OPENFOAM_PROFILE_LABEL}.log"
export DECOMPOSE_PAR_DICT=system/decomposeParDict.6
# すべての MPI 処理を1ノード内で実行するため、OFI/MLX のネットワーク経路を
# 初期化せず、Intel MPI の共有メモリ転送を使用する。
export I_MPI_FABRICS=shm
# 成否にかかわらず、一時作業ディレクトリを削除する。
cleanup() {
  status=$?
  trap - EXIT INT TERM
  rm -rf -- "${RUN_DIR:?}"
  exit "${status}"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

module purge
module load intel/2025.1.3 impi

# OpenFOAM の初期化では、bashrc 内の中間的な失敗を許容する。
set +eu
source "${PROVISION_DIR}/OpenFOAM/etc/bashrc" WM_COMPILER=Icx WM_MPLIB=INTELMPI WM_LABEL_SIZE=64 WM_PRECISION_OPTION=DP
set -eu

# OpenFOAM が使用する FFTW のライブラリを実行時の検索パスへ追加する。
export LD_LIBRARY_PATH="${FFTW_ARCH_PATH}/lib:${LD_LIBRARY_PATH:-}"

# 提出元の環境から継承した Intel MPI の設定を無効化する。ホスト固有の
# ピンニング、診断、自動チューニングによって MPI 処理の挙動が変わらないようにする。
unset I_MPI_DEBUG I_MPI_PIN_DOMAIN I_MPI_PIN_ORDER I_MPI_PIN_PROCESSOR_LIST I_MPI_ADJUST_ALLREDUCE I_MPI_TUNING_MODE I_MPI_TUNING_AUTO_SYNC I_MPI_TUNING_AUTO_ITER_NUM I_MPI_TUNING_BIN_DUMP

# チュートリアルケースを作業ディレクトリへコピーして実行場所を移動する。
cp -r "${FOAM_TUTORIALS}/incompressible/simpleFoam/motorBike" "${RUN_DIR}/"
cd "${RUN_DIR}/motorBike"

# ソルバー初期化後は約0.2秒で10ステップ進むという直近の計測結果に基づき、
# 約1分間実行されるように3000ステップへ設定する。
sed -i 's/^endTime.*/endTime         3000;/' system/controlDict
sed -i 's/^writeInterval.*/writeInterval    3000;/' system/controlDict
# MPI プロセス数と分割方式を設定する。
foamDictionary -entry numberOfSubdomains -set "${OPENFOAM_MPI_PROCS}" system/decomposeParDict.6
foamDictionary -entry method -set scotch system/decomposeParDict.6

# メッシュ生成に必要な形状を配置し、メッシュ生成・領域分割を行う。
mkdir -p constant/triSurface
cp -f "${FOAM_TUTORIALS}/resources/geometry/motorBike.obj.gz" constant/triSurface/
surfaceFeatureExtract
blockMesh
decomposePar -decomposeParDict "${DECOMPOSE_PAR_DICT}" -force
mpirun -np "${OPENFOAM_MPI_PROCS}" snappyHexMesh -parallel -decomposeParDict "${DECOMPOSE_PAR_DICT}" -overwrite
mpirun -np "${OPENFOAM_MPI_PROCS}" topoSet -parallel -decomposeParDict "${DECOMPOSE_PAR_DICT}"

for processor_dir in processor*
do
  [[ -d "${processor_dir}" ]] && cp -r 0.orig/* "${processor_dir}/0/"
done

# 初期速度場を MPI 並列で計算する。
mpirun -np "${OPENFOAM_MPI_PROCS}" potentialFoam -parallel -decomposeParDict "${DECOMPOSE_PAR_DICT}" -writephi

# プロファイルの保存先は冒頭で決めた設定を使い、必要なディレクトリを作成する。
install -d -m 0700 "${HOME}/openfoam-profile" "${OPENFOAM_PROFILE_DIR}"

# 実行条件と環境を記録し、実行ノードの CPU 情報も保存する。
printf '%s\n' \
  "profile_label=${OPENFOAM_PROFILE_LABEL}" \
  "PJM_JOBID=${PJM_JOBID}" \
  "GITHUB_RUN_ID=${GITHUB_RUN_ID:-}" \
  "launch_host=$(hostname)" \
  "mpi_procs=${OPENFOAM_MPI_PROCS}" \
  "created_at=$(date --iso-8601=seconds)" \
  > "${OPENFOAM_PROFILE_DIR}/run.txt"
cp system/decomposeParDict.6 system/controlDict "${OPENFOAM_PROFILE_DIR}/"
env | sort > "${OPENFOAM_PROFILE_DIR}/environment.txt"

mpirun -np 2 -ppn 1 bash -c 'printf "host=%s\\n" "$(hostname)"; lscpu' > "${OPENFOAM_PROFILE_DIR}/nodes.txt"

# ソルバーの開始・終了時刻を記録し、必要に応じてプロファイラを選べる形で
# MPI 並列計算を実行する。
{
  echo "profile_label=${OPENFOAM_PROFILE_LABEL}"
  echo "started_at=$(date --iso-8601=seconds)"
} | tee "${SOLVER_LOG}"

"${PROVISION_DIR}/scripts/exec-profiler.sh" \
  mpirun -np "${OPENFOAM_MPI_PROCS}" \
  simpleFoam -parallel -decomposeParDict "${DECOMPOSE_PAR_DICT}" \
  2>&1 | tee -a "${SOLVER_LOG}"

echo "finished_at=$(date --iso-8601=seconds)" | tee -a "${SOLVER_LOG}"


# プロファイルと実行ログを保存する場所を記録する。
cp "${SOLVER_LOG}" "${OPENFOAM_PROFILE_DIR}/"
du -sh "${OPENFOAM_PROFILE_DIR}" | tee \
  "${PROVISION_DIR}/logs/profile-location.txt"
printf 'profile_dir=%s\n' "${OPENFOAM_PROFILE_DIR}" | tee -a \
  "${PROVISION_DIR}/logs/profile-location.txt"

# ParaView 用のケースファイルを作成し、結果を圧縮して保存する。
touch motorBike.foam
tar -I zstd -cf "${PROVISION_DIR}/results/motorBike-${PJM_JOBID}.tar.zst" -C "${RUN_DIR}" motorBike
# ワークフロー側がジョブ成功を判定できる完了マーカーを作成する。
touch "${PROVISION_DIR}/run-success"
