#!/usr/bin/env bash
#PJM -L rscgrp=a-batch
#PJM -L node=1
#PJM -L elapse=00:25:00
#PJM --mpi proc=120

# 競技タスクの cavity3D 64M-cell ケースを1ノードで実行する。
set -euo pipefail

# ジョブの実行条件をスクリプト内で固定し、投入元の環境に依存しないようにする。
export OPENFOAM_MPI_PROCS=120

# ジョブ実行に必要な環境変数が設定されていることを確認する。
: "${OPENFOAM_RUN_ROOT:?}"
: "${PROVISION_DIR:?}"
: "${PJM_JOBID:?}"
: "${EXPERIMENT_METRICS_GOOGLE_CREDENTIALS_BASE64:?}"

# 認証情報は子の収集CLIへだけ渡す。実験プロセスの環境や保存対象には含めない。
METRICS_CREDENTIALS_BASE64="${EXPERIMENT_METRICS_GOOGLE_CREDENTIALS_BASE64}"
unset EXPERIMENT_METRICS_GOOGLE_CREDENTIALS_BASE64

# ジョブ専用の作業ディレクトリとプロファイルの保存先を先に決めておく。
export RUN_DIR="$(mktemp -d "${OPENFOAM_RUN_ROOT}/job-${PJM_JOBID}.XXXXXXXXXX")"
export CASE_DIR="${RUN_DIR}/cavity3D-64M"
export OPENFOAM_PROFILE_RUN_ID="${GITHUB_RUN_ID:-manual}-${PJM_JOBID}"
export OPENFOAM_PROFILE_DIR="${HOME}/openfoam-profile/${OPENFOAM_PROFILE_RUN_ID}"
export SOLVER_LOG="${PROVISION_DIR}/logs/log.icoFoam"
export DECOMPOSE_PAR_DICT=system/decomposeParDict.6
export EXPERIMENT_METRICS_CLI="${PROVISION_DIR}/experiment-metrics/.venv/bin/experiment-metrics"
PIPELINE_STARTED_SECONDS=${SECONDS}

metrics_cli() {
  EXPERIMENT_METRICS_GOOGLE_CREDENTIALS_BASE64="${METRICS_CREDENTIALS_BASE64}" \
    "${EXPERIMENT_METRICS_CLI}" "$@"
}

metrics_collect() {
  metrics_cli collect "$@" || true
}

# すべての MPI 処理を1ノード内で実行するため、OFI/MLX のネットワーク経路を
# 初期化せず、Intel MPI の共有メモリ転送を使用する。
export I_MPI_FABRICS=shm
# 成否にかかわらず、一時作業ディレクトリを削除する。
cleanup() {
  status=$?
  trap - EXIT INT TERM
  run_elapsed_sec="$((SECONDS - PIPELINE_STARTED_SECONDS))"
  metrics_collect run-end --case-dir "${CASE_DIR}" --exit-code "${status}" --elapsed-sec "${run_elapsed_sec}"
  rm -rf -- "${RUN_DIR:?}"
  exit "${status}"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

module purge
module load intel/2025.1.3 impi

# OpenFOAM の初期化では、bashrc 内の中間的な失敗を許容する。
set +eu
source "${PROVISION_DIR}/OpenFOAM/etc/bashrc" WM_COMPILER=Icx WM_MPLIB=INTELMPI WM_LABEL_SIZE=64 WM_PRECISION_OPTION=DP
set -eu

# 提出元の環境から継承した Intel MPI の設定を無効化する。ホスト固有の
# ピンニング、診断、自動チューニングによって MPI 処理の挙動が変わらないようにする。
unset I_MPI_DEBUG I_MPI_PIN_DOMAIN I_MPI_PIN_ORDER I_MPI_PIN_PROCESSOR_LIST I_MPI_ADJUST_ALLREDUCE I_MPI_TUNING_MODE I_MPI_TUNING_AUTO_SYNC I_MPI_TUNING_AUTO_ITER_NUM I_MPI_TUNING_BIN_DUMP

# submodule で固定した競技ケースをジョブ専用領域へコピーする。
cp -a "${PROVISION_DIR}/task/cavity3D-64M" "${CASE_DIR}"
cd "${CASE_DIR}"

# Genkai の1ノード120ランク向けに、可変である分割数だけを追加する。
cat > "${DECOMPOSE_PAR_DICT}" <<EOF
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object decomposeParDict;
}

numberOfSubdomains ${OPENFOAM_MPI_PROCS};
method scotch;
EOF

metrics_collect run-start --case-dir . --command mpirun -np "${OPENFOAM_MPI_PROCS}" icoFoam -parallel -decomposeParDict "${DECOMPOSE_PAR_DICT}"
metrics_collect platform --case-dir .
metrics_collect parallel --case-dir .

PIPELINE_STARTED_SECONDS=${SECONDS}
metrics_cli stage block_mesh -- blockMesh
metrics_cli stage decompose_par -- decomposePar -decomposeParDict "${DECOMPOSE_PAR_DICT}" -force

# プロファイルの保存先は冒頭で決めた設定を使い、必要なディレクトリを作成する。
install -d -m 0700 "${HOME}/openfoam-profile" "${OPENFOAM_PROFILE_DIR}"

# 実行条件と環境を記録し、実行ノードの CPU 情報も保存する。
printf '%s\n' \
  "PJM_JOBID=${PJM_JOBID}" \
  "GITHUB_RUN_ID=${GITHUB_RUN_ID:-}" \
  "launch_host=$(hostname)" \
  "mpi_procs=${OPENFOAM_MPI_PROCS}" \
  "created_at=$(date --iso-8601=seconds)" \
  > "${OPENFOAM_PROFILE_DIR}/run.txt"
cp system/decomposeParDict.6 system/controlDict "${OPENFOAM_PROFILE_DIR}/"
env | sort > "${OPENFOAM_PROFILE_DIR}/environment.txt"

{
  printf 'host=%s\n' "$(hostname)"
  lscpu
} > "${OPENFOAM_PROFILE_DIR}/nodes.txt"

# ソルバーの開始・終了時刻を記録し、必要に応じてプロファイラを選べる形で
# MPI 並列計算を実行する。
echo "started_at=$(date --iso-8601=seconds)" | tee "${SOLVER_LOG}"

set +e
metrics_cli stage ico_foam -- "${PROVISION_DIR}/scripts/exec-profiler.sh" mpirun -np "${OPENFOAM_MPI_PROCS}" icoFoam -parallel -decomposeParDict "${DECOMPOSE_PAR_DICT}" 2>&1 | tee -a "${SOLVER_LOG}"
solver_status=${PIPESTATUS[0]}
set -e

echo "finished_at=$(date --iso-8601=seconds)" | tee -a "${SOLVER_LOG}"

metrics_collect solver-status --case-dir . --exit-code "${solver_status}"

if [[ "${solver_status}" -ne 0 ]]; then
  exit "${solver_status}"
fi

# 競技付属の検証器で固定 workload の完走を確認し、提出可能な小さい成果物を残す。
"${PROVISION_DIR}/task/parse_result.sh" "${SOLVER_LOG}" | tee "${PROVISION_DIR}/results/result.txt"
grep -qx 'STATUS: VALID' "${PROVISION_DIR}/results/result.txt"
grep -q '^RESULT:' "${PROVISION_DIR}/results/result.txt"
cp "${SOLVER_LOG}" "${PROVISION_DIR}/results/log.icoFoam"

# プロファイルと実行ログを保存する場所を記録する。
cp "${SOLVER_LOG}" "${OPENFOAM_PROFILE_DIR}/"
du -sh "${OPENFOAM_PROFILE_DIR}" | tee \
  "${PROVISION_DIR}/logs/profile-location.txt"
printf 'profile_dir=%s\n' "${OPENFOAM_PROFILE_DIR}" | tee -a \
  "${PROVISION_DIR}/logs/profile-location.txt"

# ワークフロー側がジョブ成功を判定できる完了マーカーを作成する。
touch "${PROVISION_DIR}/run-success"
