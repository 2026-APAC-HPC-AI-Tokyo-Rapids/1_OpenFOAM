#!/usr/bin/env bash
#PJM -L rscgrp=a-batch
#PJM -L node=1
#PJM -L elapse=00:25:00
#PJM --mpi proc=120

# Execute one OpenFOAM motorBike case from a provisioned runtime tree.
set -euo pipefail

: "${OPENFOAM_MPI_PROCS:?}"
: "${OPENFOAM_RUN_ROOT:?}"
: "${PROVISION_DIR:?}"

run_dir="$(mktemp -d "${OPENFOAM_RUN_ROOT}/job-${PJM_JOBID}.XXXXXXXXXX")"

cleanup() {
  status=$?
  trap - EXIT INT TERM
  rm -rf -- "${run_dir:?}"
  exit "${status}"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

module purge
module load intel/2025.1.3 impi

# OpenFOAM initialization intentionally tolerates intermediate failures.
set +eu
source "${PROVISION_DIR}/OpenFOAM/etc/bashrc" \
  WM_COMPILER=Icx \
  WM_MPLIB=INTELMPI \
  WM_LABEL_SIZE=64 \
  WM_PRECISION_OPTION=DP
set -eu

export LD_LIBRARY_PATH="${FFTW_ARCH_PATH}/lib:${LD_LIBRARY_PATH:-}"

cp -r "${FOAM_TUTORIALS}/incompressible/simpleFoam/motorBike" "${run_dir}/"
cd "${run_dir}/motorBike"

# The latest measured run advanced 10 steps in about 0.2 seconds after solver
# initialization, so 3000 steps keeps the simulation active for roughly a minute.
sed -i 's/^endTime.*/endTime         3000;/' system/controlDict
sed -i 's/^writeInterval.*/writeInterval    3000;/' system/controlDict
foamDictionary -entry numberOfSubdomains -set "${OPENFOAM_MPI_PROCS}" system/decomposeParDict.6
foamDictionary -entry method -set scotch system/decomposeParDict.6

decompose_args=(-decomposeParDict system/decomposeParDict.6)

mkdir -p constant/triSurface
cp -f "${FOAM_TUTORIALS}/resources/geometry/motorBike.obj.gz" constant/triSurface/
surfaceFeatureExtract
blockMesh
decomposePar "${decompose_args[@]}" -force
mpirun -np "${OPENFOAM_MPI_PROCS}" snappyHexMesh -parallel "${decompose_args[@]}" -overwrite
mpirun -np "${OPENFOAM_MPI_PROCS}" topoSet -parallel "${decompose_args[@]}"

for processor_dir in processor*
do
  [[ -d "${processor_dir}" ]] && cp -r 0.orig/* "${processor_dir}/0/"
done

mpirun -np "${OPENFOAM_MPI_PROCS}" potentialFoam -parallel "${decompose_args[@]}" -writephi

solver_args=(
  simpleFoam
  -parallel
  "${decompose_args[@]}"
)
profile_run_id="${GITHUB_RUN_ID:-manual}-${PJM_JOBID}"
export OPENFOAM_PROFILE_DIR="${HOME}/openfoam-profile/${profile_run_id}"
export OPENFOAM_PROFILE_ANALYSIS=none
export OPENFOAM_PROFILE_LABEL=mpi-1node-120ranks-allreduce-knomial
export OPENFOAM_PROFILE_RANK=0
export I_MPI_DEBUG=5
unset I_MPI_FABRICS
unset I_MPI_PIN_DOMAIN
unset I_MPI_PIN_ORDER
unset I_MPI_PIN_PROCESSOR_LIST
export I_MPI_ADJUST_ALLREDUCE=9
solver_log="${PROVISION_DIR}/logs/solver-${OPENFOAM_PROFILE_LABEL}.log"
install -d -m 0700 "${HOME}/openfoam-profile" "${OPENFOAM_PROFILE_DIR}"

printf '%s\n' \
  "analysis=${OPENFOAM_PROFILE_ANALYSIS}" \
  "profile_rank=${OPENFOAM_PROFILE_RANK}" \
  "PJM_JOBID=${PJM_JOBID}" \
  "GITHUB_RUN_ID=${GITHUB_RUN_ID:-}" \
  "launch_host=$(hostname)" \
  "mpi_procs=${OPENFOAM_MPI_PROCS}" \
  "created_at=$(date --iso-8601=seconds)" \
  > "${OPENFOAM_PROFILE_DIR}/run.txt"
cp system/decomposeParDict.6 system/controlDict "${OPENFOAM_PROFILE_DIR}/"
env | sort > "${OPENFOAM_PROFILE_DIR}/environment.txt"
mpirun -np 2 -ppn 1 bash -c \
  'printf "host=%s\\n" "$(hostname)"; lscpu' \
  > "${OPENFOAM_PROFILE_DIR}/nodes.txt"

{
  echo "analysis=${OPENFOAM_PROFILE_ANALYSIS}"
  echo "profile_rank=${OPENFOAM_PROFILE_RANK}"
  echo "started_at=$(date --iso-8601=seconds)"
} | tee "${solver_log}"
"${PROVISION_DIR}/scripts/exec-profiler.sh" \
  "${solver_args[@]}" 2>&1 | tee -a "${solver_log}"
echo "finished_at=$(date --iso-8601=seconds)" | tee -a "${solver_log}"

cp "${solver_log}" "${OPENFOAM_PROFILE_DIR}/"
du -sh "${OPENFOAM_PROFILE_DIR}" | tee \
  "${PROVISION_DIR}/logs/profile-location.txt"
printf 'profile_dir=%s\n' "${OPENFOAM_PROFILE_DIR}" | tee -a \
  "${PROVISION_DIR}/logs/profile-location.txt"

touch motorBike.foam
tar -I zstd -cf "${PROVISION_DIR}/results/motorBike-${PJM_JOBID}.tar.zst" -C "${run_dir}" motorBike
touch "${PROVISION_DIR}/run-success"
