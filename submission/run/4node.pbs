#!/usr/bin/env bash
#PBS -l nodes=4:ppn=112
#PBS -l walltime=01:00:00

module purge
module load intel/2025.1.3 impi
source "${WM_PROJECT_DIR}/etc/bashrc"

case_dir="${PBS_O_WORKDIR}/case-4node"
rank_count=448
iteration_count=150

rm -rf "${case_dir}"
cp -a "${PBS_O_WORKDIR}/../../benchmark/occDrivAerStaticMesh" "${case_dir}"
cp "${case_dir}/system/fvSolution.fixedIter" "${case_dir}/system/fvSolution"
cp -a "${case_dir}/0.orig" "${case_dir}/0"
sed -i "s/^nCores.*/nCores              ${rank_count};/; s/^decompositionMethod.*/decompositionMethod scotch;/" "${case_dir}/system/include/caseDefinition"
sed -i "s/^endTime.*/endTime         ${iteration_count};/" "${case_dir}/system/controlDict"

cd "${case_dir}"
checkMesh -constant > checkMesh.log 2>&1
decomposePar -constant > decomposePar.log 2>&1
restore0Dir -processor
mpirun -np "${rank_count}" renumberMesh -constant -overwrite -parallel > renumberMesh.log 2>&1
mpirun -np "${rank_count}" potentialFoam -initialiseUBCs -parallel > potentialFoam.log 2>&1
mpirun -np "${rank_count}" applyBoundaryLayer -ybl 0.0450244 -parallel > applyBoundaryLayer.log 2>&1
mpirun -np "${rank_count}" simpleFoam -parallel > simpleFoam.log 2>&1
