{
  "schema_version": "instrumentation-bundle/v1",
  "bundle_track": "profile",
  "source_paths": [
    "platforms/aspire2a/export-craypat.sh",
    "platforms/aspire2a/run-openfoam.pbs",
    "scripts/run-openfoam.sh"
  ],
  "components": [
    {
      "component_id": "openfoam.craypat-mpi/v1",
      "sink_ids": [
        "craypat-mpi-report"
      ],
      "activation": {
        "kind": "executable",
        "artifact_relative_path": "scripts/run-openfoam.sh",
        "argv_template": [
          [
            {
              "token": "component_executable"
            }
          ],
          [
            {
              "token": "stage_executable",
              "role": "simpleFoam"
            }
          ]
        ]
      }
    }
  ],
  "environment_capture_scopes": [],
  "sink_bindings": [
    {
      "sink_id": "craypat-mpi-report",
      "source_id": "openfoam.craypat-mpi-report/v1",
      "buffering_mode": "stage_buffered"
    }
  ],
  "environment_bindings": []
}
