{
  "schema_version": "instrumentation-bundle/v1",
  "bundle_track": "profile",
  "source_paths": [
    "experiment-metrics/src/experiment_metrics/profile_vtune.py",
    "scripts/allow-vtune-attach.py",
    "scripts/exec-profiler.sh",
    "scripts/export-vtune-hotspots.sh"
  ],
  "components": [
    {
      "component_id": "openfoam.vtune-hotspots/v1",
      "sink_ids": [
        "vtune-hotspots-report"
      ],
      "activation": {
        "kind": "executable",
        "artifact_relative_path": "scripts/exec-profiler.sh",
        "argv_template": [
          [
            {
              "token": "component_executable"
            }
          ],
          [
            {
              "token": "stage_executable",
              "role": "simpleFoam"
            }
          ]
        ]
      }
    }
  ],
  "environment_capture_scopes": [],
  "sink_bindings": [
    {
      "sink_id": "vtune-hotspots-report",
      "source_id": "openfoam.vtune-hotspots-report/v1",
      "buffering_mode": "stage_buffered"
    }
  ],
  "environment_bindings": []
}
